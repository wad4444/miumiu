return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local jecs = require(ReplicatedStorage.Packages.jecs)
	local miumiu = require(ReplicatedStorage.Packages.miumiu)
	local schema = require(ReplicatedStorage.Packages.miumiu.schema)
	local state = require(ReplicatedStorage.Packages.miumiu.state)
	local utils = require(ReplicatedStorage.Tests.utils)

	type Entity<T = nil> = miumiu.Entity<T>
	type Fixture = utils.Fixture

	afterEach(utils.cleanup)

	local never = utils.timings.never
	local settle = utils.settle

	type Kinds = {
		owns: Entity,
		item: Entity,
		part_of: Entity,
		part: Entity,
		holds: Entity,
		container: Entity,
		container_kind: Entity<string>,
	}

	local function declare(t: Fixture): Kinds
		local world = t.world
		local kinds = utils.declare_kinds(world, t.player_data)
		local owns, item, holds, container, container_kind =
			kinds.owns, kinds.item, kinds.holds, kinds.container, kinds.container_kind
		local part_of = world:entity()
		world:add(part_of, jecs.Exclusive)
		local part = world:entity()
		world:set(part, jecs.Name, "part")
		world:set(part, miumiu.child, { via = part_of, key = "parts", mode = "owned" })
		utils.scope(world, { t.money, t.tutorial, t.items }, { item, part })
		utils.scope(world, { t.money, t.tutorial }, { container })
		utils.scope(world, { item }, { container })
		utils.scope(world, { container, part }, { item })
		return {
			owns = owns,
			item = item,
			part_of = part_of,
			part = part,
			holds = holds,
			container = container,
			container_kind = container_kind,
		}
	end

	local function setup()
		local t = utils.create_fixture({ pull_interval = never })
		return t, declare(t)
	end

	local give = utils.give
	local make_container = utils.make_container
	local id_of = utils.id_of
	local items_of = utils.items_of

	local function attach_part(t: Fixture, k: Kinds, parent: Entity, money: number): Entity
		local part = t.world:entity()
		t.world:add(part, k.part)
		t.world:set(part, t.money, money)
		t.world:add(part, jecs.pair(k.part_of, parent))
		return part
	end

	describe("owned children", function()
		it("are stored under their key with a minted id", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local sword = give(t, k, player, 5)
			local id = id_of(t, sword)
			expect(type(id)).to.equal("string")
			utils.session_of(t, "p1"):sync()
			local record = t.backend:dump("p1")
			expect(record.data.inventory[id].money).to.equal(5)
			expect(record.data.money).to.equal(nil)
		end)

		it("re-put the child on every change and coalesce unwritten puts", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local sword = give(t, k, player, 1)
			local session = utils.session_of(t, "p1")
			session:sync()
			t.world:set(sword, t.money, 2)
			t.world:set(sword, t.money, 3)
			t.world:add(sword, t.tutorial)
			expect(session:get_truth().inventory[id_of(t, sword)].money).to.equal(3)
			local function landed_groups(): number
				return utils.count(t.backend:dump("p1").landed)
			end
			local groups = landed_groups()
			session:sync()
			expect(landed_groups()).to.equal(groups + 1)
			local stored = t.backend:dump("p1").data.inventory[id_of(t, sword)]
			expect(stored.money).to.equal(3)
			expect(stored.tutorial).to.equal(true)
		end)

		it("are dropped when the pair is removed or the entity deleted", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local a = give(t, k, player, 1)
			local b = give(t, k, player, 2)
			local session = utils.session_of(t, "p1")
			session:sync()
			t.world:remove(a, jecs.pair(k.owns, player))
			t.world:delete(b)
			session:sync()
			local inventory = t.backend:dump("p1").data.inventory
			expect((next(inventory))).to.equal(nil)
		end)

		it("move to the new owner when re-parented", function()
			local t, k = setup()
			local a = utils.link_entity(t, "p1")
			local b = utils.link_entity(t, "p2")
			local sword = give(t, k, a, 9)
			local id = id_of(t, sword)
			utils.session_of(t, "p1"):sync()
			t.world:add(sword, jecs.pair(k.owns, b))
			utils.session_of(t, "p1"):sync()
			utils.session_of(t, "p2"):sync()
			expect(t.backend:dump("p1").data.inventory[id]).to.equal(nil)
			expect(t.backend:dump("p2").data.inventory[id].money).to.equal(9)
			expect(id_of(t, sword)).to.equal(id)
		end)

		it("nest and put the nearest child on a nested change", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local golem = give(t, k, player, 0)
			local arm = t.world:entity()
			t.world:add(arm, k.part)
			t.world:set(arm, t.money, 4)
			t.world:add(arm, jecs.pair(k.part_of, golem))
			local session = utils.session_of(t, "p1")
			session:sync()
			local stored = t.backend:dump("p1").data.inventory[id_of(t, golem)]
			expect(stored.parts[id_of(t, arm)].money).to.equal(4)
			t.world:set(arm, t.money, 6)
			expect(session:get_truth().inventory[id_of(t, golem)].parts[id_of(t, arm)].money).to.equal(6)
			t.world:delete(golem)
			session:sync()
			expect((next(t.backend:dump("p1").data.inventory))).to.equal(nil)
		end)

		it("spawn on load with their id, components and nested children", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local golem = give(t, k, player, 1)
			local arm = t.world:entity()
			t.world:add(arm, k.part)
			t.world:set(arm, t.money, 4)
			t.world:add(arm, jecs.pair(k.part_of, golem))
			local golem_id, arm_id = id_of(t, golem), id_of(t, arm)
			utils.session_of(t, "p1"):sync()
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			t.world:delete(golem)
			t.world:delete(arm)
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local items = items_of(t, k, player)
			local spawned = items[golem_id]
			expect(spawned).to.be.ok()
			expect(t.world:get(spawned, t.money)).to.equal(1)
			local parts = {}
			for entity in t.world:each(jecs.pair(k.part_of, spawned)) do
				parts[id_of(t, entity)] = entity
			end
			expect(t.world:get(parts[arm_id], t.money)).to.equal(4)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
		end)

		it("follow remote puts and drops", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local remote = utils.other_server(t, "p1")
			utils.journal(
				remote,
				{ { kind = "put", key = "inventory", path = { "gift" }, at = 1, value = { money = 7 } } }
			)
			remote:sync()
			utils.session_of(t, "p1"):sync()
			miumiu.step(t.world)
			local gift = items_of(t, k, player).gift
			expect(gift).to.be.ok()
			expect(t.world:get(gift, t.money)).to.equal(7)
			utils.journal(remote, { { kind = "drop", key = "inventory", path = { "gift" }, at = 1 } })
			remote:sync()
			utils.session_of(t, "p1"):sync()
			miumiu.step(t.world)
			expect(t.world:contains(gift)).to.equal(false)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
			remote:unload()
		end)

		it("follow a remote drop of a child that carries children", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local remote = utils.other_server(t, "p1")
			utils.journal(remote, {
				{
					kind = "put",
					key = "inventory",
					path = { "golem" },
					at = 1,
					value = { money = 1, parts = { arm = { money = 2 } } },
				},
			})
			remote:sync()
			utils.session_of(t, "p1"):sync()
			miumiu.step(t.world)
			local golem = items_of(t, k, player).golem
			local arm = nil
			for entity in t.world:each(jecs.pair(k.part_of, golem)) do
				arm = entity
			end
			expect(t.world:get(arm, t.money)).to.equal(2)
			utils.journal(remote, { { kind = "drop", key = "inventory", path = { "golem" }, at = 1 } })
			remote:sync()
			utils.session_of(t, "p1"):sync()
			miumiu.step(t.world)
			expect(t.world:contains(golem)).to.equal(false)
			expect(t.world:contains(arm)).to.equal(false)
			remote:unload()
		end)

		it("count from the moment the tag arrives, whichever order tag and pair come in", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local session = utils.session_of(t, "p1")
			local late = t.world:entity()
			t.world:set(late, t.money, 5)
			t.world:add(late, jecs.pair(k.owns, player))
			expect(session:is_dirty()).to.equal(false)
			t.world:add(late, k.item)
			expect(session:is_dirty()).to.equal(true)
			session:sync()
			expect(t.backend:dump("p1").data.inventory[id_of(t, late)].money).to.equal(5)
			t.world:remove(late, k.item)
			session:sync()
			expect((next(t.backend:dump("p1").data.inventory))).to.equal(nil)
		end)

		it("wait for a loading parent outside batch and are rejected inside it", function()
			local t, k = setup()
			local loaded = utils.link_entity(t, "p1", { money = 1 })
			t.backend:delay_next("GetAsync", utils.timings.in_flight, "before")
			local loading = t.world:entity()
			t.world:set(loading, t.link, "p2")
			miumiu.step(t.world)
			local early = give(t, k, loading, 3)
			expect(t.world:has(early, jecs.pair(k.owns, loading))).to.equal(true)
			local rejected = t.world:entity()
			t.world:add(rejected, k.item)
			expect(function()
				miumiu.batch(t.world, function()
					t.world:set(loaded, t.money, 2)
					t.world:add(rejected, jecs.pair(k.owns, loading))
				end)
			end).to.throw("not loaded")
			expect(t.world:get(loaded, t.money)).to.equal(1)
			expect(t.world:has(rejected, jecs.pair(k.owns, loading))).to.equal(false)
			settle(t, loading)
			expect(items_of(t, k, loading)[id_of(t, early)]).to.equal(nil)
		end)

		it("rethrow a listener error during a child supply", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local remote = utils.other_server(t, "p1")
			utils.journal(
				remote,
				{ { kind = "put", key = "inventory", path = { "gift" }, at = 1, value = { money = 7 } } }
			)
			remote:sync()
			t.world:added(t.money, function(entity)
				if t.world:has(entity, k.item) then
					error("child boom")
				end
			end)
			utils.session_of(t, "p1"):sync()
			expect(function()
				miumiu.step(t.world)
			end).to.throw("child boom")
			expect(t.world:get(items_of(t, k, player).gift, t.money)).to.equal(7)
			remote:unload()
		end)

		it("ignore entities on the relation without the kind tag", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local snowball = t.world:entity()
			t.world:set(snowball, t.money, 3)
			t.world:add(snowball, jecs.pair(k.owns, player))
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
		end)

		it("are dropped silently under an unloaded parent and rejected inside batch", function()
			local t, k = setup()
			local stranger = t.world:entity()
			miumiu.step(t.world)
			give(t, k, stranger, 1)
			local player = utils.link_entity(t, "p1")
			expect(function()
				miumiu.batch(t.world, function()
					t.world:set(player, t.money, 1)
					give(t, k, stranger, 2)
				end)
			end).to.throw("not loaded")
			expect(t.world:get(player, t.money)).to.equal(nil)
		end)

		it("move between two players inside one batch, or not at all", function()
			local t, k = setup()
			local a = utils.link_entity(t, "p1", { money = 1 })
			local b = utils.link_entity(t, "p2", { money = 1 })
			local sword = give(t, k, a, 9)
			local id = id_of(t, sword)
			utils.session_of(t, "p1"):sync()
			miumiu
				.batch(t.world, function()
					t.world:add(sword, jecs.pair(k.owns, b))
					t.world:set(sword, t.money, 10)
				end)
				:await()
			expect(t.backend:dump("p1").data.inventory[id]).to.equal(nil)
			expect(t.backend:dump("p2").data.inventory[id].money).to.equal(10)

			t.backend:fail_next("SetAsync", "before", "commit down")
			t.backend:fail_next("GetAsync", "before", "lookup down")
			local outcome = miumiu
				.batch(t.world, function()
					t.world:add(sword, jecs.pair(k.owns, a))
				end)
				:await()
			assert(outcome.kind == "refused")
			expect((string.find(outcome.message, "commit down", 1, true))).to.be.ok()
			expect(t.world:has(sword, jecs.pair(k.owns, b))).to.equal(true)
			expect(t.world:has(sword, jecs.pair(k.owns, a))).to.equal(false)
		end)
	end)

	describe("attached children", function()
		it("are supplied from the record on claim and keep their state after unclaim", function()
			local t, k = setup()
			local plot = make_container(t, k, "plot")
			t.world:set(plot, t.money, 99)
			local player = utils.link_entity(t, "p1")
			local session = utils.session_of(t, "p1")
			t.world:add(plot, jecs.pair(k.holds, player))
			expect(t.world:get(plot, t.money)).to.equal(99)
			t.world:set(plot, t.money, 7)
			session:sync()
			expect(t.backend:dump("p1").data.containers.plot.money).to.equal(7)

			t.world:remove(plot, jecs.pair(k.holds, player))
			t.world:set(plot, t.money, 8)
			session:sync()
			expect(t.backend:dump("p1").data.containers.plot.money).to.equal(7)
			expect(session:is_dirty()).to.equal(false)

			local other = utils.link_entity(t, "p2")
			t.world:add(plot, jecs.pair(k.holds, other))
			expect(t.world:get(plot, t.money)).to.equal(99)
			t.world:remove(plot, jecs.pair(k.holds, other))

			t.world:add(plot, jecs.pair(k.holds, player))
			expect(t.world:get(plot, t.money)).to.equal(7)
		end)

		it("claimed before the link are supplied on load", function()
			local t, k = setup()
			t.backend:seed("p1", { data = { containers = { plot = { money = 3, tutorial = true } } } })
			local plot = make_container(t, k, "plot")
			local player = t.world:entity()
			t.world:add(plot, jecs.pair(k.holds, player))
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect(t.world:get(plot, t.money)).to.equal(3)
			expect(t.world:has(plot, t.tutorial)).to.equal(true)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
		end)

		it("hold owned children that spawn and vanish with the record", function()
			local t, k = setup()
			local plot = make_container(t, k, "plot")
			local player = utils.link_entity(t, "p1")
			t.world:add(plot, jecs.pair(k.holds, player))
			local golem = t.world:entity()
			t.world:add(golem, k.item)
			t.world:set(golem, t.money, 2)
			t.world:add(golem, jecs.pair(k.owns, plot))
			local session = utils.session_of(t, "p1")
			session:sync()
			expect(t.backend:dump("p1").data.containers.plot.inventory[id_of(t, golem)].money).to.equal(2)
			t.world:remove(plot, jecs.pair(k.holds, player))
			t.world:delete(golem)
			t.world:add(plot, jecs.pair(k.holds, player))
			local restored = items_of(t, k, plot)
			local _, spawned = next(restored)
			expect(t.world:get(spawned, t.money)).to.equal(2)
		end)

		it("keep their pre-claim values when the record has nothing for them on load", function()
			local t, k = setup()
			t.backend:seed("p1", { data = { money = 1 } })
			local plot = make_container(t, k, "plot")
			t.world:set(plot, t.money, 50)
			local player = t.world:entity()
			t.world:add(plot, jecs.pair(k.holds, player))
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect(t.world:get(plot, t.money)).to.equal(50)
		end)

		it("do nothing when claimed by an unlinked or loading holder", function()
			local t, k = setup()
			local plot = make_container(t, k, "plot")
			t.world:set(plot, t.money, 5)
			local stranger = t.world:entity()
			miumiu.step(t.world)
			t.world:add(plot, jecs.pair(k.holds, stranger))
			expect(t.world:get(plot, t.money)).to.equal(5)
			t.world:remove(plot, jecs.pair(k.holds, stranger))
			t.backend:seed("p1", { data = { containers = { plot = { money = 6 } } } })
			t.backend:delay_next("GetAsync", utils.timings.in_flight, "before")
			local loading = t.world:entity()
			t.world:set(loading, t.link, "p1")
			miumiu.step(t.world)
			t.world:add(plot, jecs.pair(k.holds, loading))
			expect(t.world:get(plot, t.money)).to.equal(5)
			settle(t, loading)
			expect(t.world:get(plot, t.money)).to.equal(6)
		end)

		it("need an id", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local plot = t.world:entity()
			t.world:add(plot, k.container)
			expect(function()
				t.world:add(plot, jecs.pair(k.holds, player))
			end).to.throw("has no id")
			expect(t.world:has(plot, jecs.pair(k.holds, player))).to.equal(false)
		end)
	end)

	describe("snapshots", function()
		it("are evaluated before a write, on the final write, never on an idle read", function()
			local t = utils.create_fixture({ pull_interval = never })
			local clock = 0
			t.world:set(t.money, miumiu.snapshot, function()
				return clock
			end)
			local player = utils.link_entity(t, "p1")
			local session = utils.session_of(t, "p1")
			clock = 1
			session:sync()
			expect(t.backend.calls.UpdateAsync).to.equal(nil)
			expect(t.world:get(player, t.money)).to.equal(nil)
			t.world:set(player, t.items, { "a" })
			clock = 2
			session:sync()
			expect(t.backend:dump("p1").data.money).to.equal(2)
			clock = 3
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(utils.wait_until(function()
				return not session:is_open()
			end)).to.equal(true)
			expect(t.backend:dump("p1").data.money).to.equal(3)
		end)

		it("warn and skip when the function throws or yields", function()
			local t = utils.create_fixture({ pull_interval = never })
			t.world:set(t.money, miumiu.snapshot, function()
				task.wait()
				return 1
			end)
			local player = utils.link_entity(t, "p1")
			t.world:set(player, t.items, { "a" })
			utils.session_of(t, "p1"):sync()
			expect(utils.warned(t.backend, "snapshot")).to.equal(true)
			expect(t.backend:dump("p1").data.money).to.equal(nil)
		end)

		it("run on close", function()
			local t = utils.create_fixture({ pull_interval = never })
			t.world:set(t.money, miumiu.snapshot, function()
				return 42
			end)
			local player = utils.link_entity(t, "p1")
			t.world:set(player, t.items, { "a" })
			miumiu.close(t.world)
			expect(t.backend:dump("p1").data.money).to.equal(42)
		end)
	end)

	describe("migrations with children", function()
		it("see children as entities and store what they change", function()
			local t, k = setup()
			t.world:set(t.player_data, miumiu.migrations, {
				function(world, entity)
					for child in world:each(jecs.pair(k.owns, entity)) do
						world:set(child, t.money, world:get(child, t.money) * 2)
					end
					local extra = world:entity()
					world:add(extra, k.item)
					world:set(extra, t.money, 1)
					world:add(extra, jecs.pair(k.owns, entity))
				end,
			})
			t.backend:seed("p1", { data = { inventory = { old = { money = 5 } } } })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local inventory = t.backend:dump("p1").data.inventory
			expect(inventory.old.money).to.equal(10)
			expect(utils.count(inventory)).to.equal(2)
			expect(t.world:get(items_of(t, k, player).old, t.money)).to.equal(10)
		end)

		it("create the first child of a kind on a record that has none", function()
			local t, k = setup()
			t.world:set(t.player_data, miumiu.migrations, {
				function(world, entity)
