			t.backend:fail_next("UpdateAsync", "before", "store down again")
			local first = miumiu.batch(t.world, function()
				t.world:remove(sword, jecs.pair(k.owns, player))
				t.world:remove(sword, k.item)
			end)
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			local second = miumiu.batch(t.world, function()
				t.world:add(sword, k.item)
				t.world:add(sword, jecs.pair(k.owns, player))
			end)
			expect(first:await().kind).to.equal("refused")
			expect(second:await().kind).to.equal("refused")
			expect(t.world:has(sword, k.item)).to.equal(true)
			expect(t.world:has(sword, jecs.pair(k.owns, player))).to.equal(true)
			expect(state.get(t.world).children.by_entity[sword]).never.to.equal(nil)
			expect(t.backend:dump("p1").data.inventory[id]).to.be.ok()
			expect(items_of(t, k, player)[id]).to.equal(sword)
		end)

		it("skips re-parenting a dropped child under a parent deleted meanwhile", function()
			local t = utils.create_fixture({ pull_interval = never, retry_attempts = 1 })
			local k = declare(t)
			local player = utils.link_entity(t, "p1")
			local session = utils.session_of(t, "p1")
			local golem = give(t, k, player, 1)
			local arm = attach_part(t, k, golem, 2)
			session:sync()
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			t.backend:fail_next("UpdateAsync", "before", "store down")
			local batch = miumiu.batch(t.world, function()
				t.world:remove(arm, jecs.pair(k.part_of, golem))
			end)
			t.world:delete(golem)
			miumiu.step(t.world)
			expect(batch:await().kind).to.equal("refused")
			expect(t.world:contains(arm)).to.equal(true)
			expect(utils.warned(t.backend, "rollback")).to.equal(false)
		end)

		it("keeps the pre-claim baseline when an unclaim and re-claim inside a batch are rolled back", function()
			local t = utils.create_fixture({ pull_interval = never })
			local k = declare(t)
			t.backend:seed("p1", { data = { containers = { plot = { money = 9 } } } })
			t.backend:seed("p2", { data = { containers = { plot = { money = 5 } } } })
			local a = utils.link_entity(t, "p1")
			local b = utils.link_entity(t, "p2")
			local plot = make_container(t, k, "plot")
			t.world:set(plot, t.money, 1)
			t.world:add(plot, jecs.pair(k.holds, a))
			expect(t.world:get(plot, t.money)).to.equal(9)
			expect(function()
				miumiu.batch(t.world, function()
					t.world:remove(plot, jecs.pair(k.holds, a))
					t.world:add(plot, jecs.pair(k.holds, b))
					expect(t.world:get(plot, t.money)).to.equal(5)
					error("nope")
				end)
			end).to.throw("nope")
			expect(t.world:has(plot, jecs.pair(k.holds, a))).to.equal(true)
			expect(t.world:get(plot, t.money)).to.equal(9)
			t.world:remove(plot, jecs.pair(k.holds, a))
			miumiu.step(t.world)
			expect(t.world:get(plot, t.money)).to.equal(1)
		end)

		it("keeps the claim when a claimed attached child is cleared inside a failed batch", function()
			local t = utils.create_fixture({ pull_interval = never })
			local k = declare(t)
			t.backend:seed("p1", { data = { containers = { plot = { money = 9 } } } })
			local player = utils.link_entity(t, "p1")
			local plot = make_container(t, k, "plot")
			t.world:set(plot, t.money, 1)
			t.world:add(plot, jecs.pair(k.holds, player))
			expect(t.world:get(plot, t.money)).to.equal(9)
			expect(function()
				miumiu.batch(t.world, function()
					t.world:clear(plot)
					error("nope")
				end)
			end).to.throw("nope")
			expect(t.world:has(plot, jecs.pair(k.holds, player))).to.equal(true)
			expect(state.get(t.world).children.by_entity[plot]).never.to.equal(nil)
			miumiu.step(t.world)
			expect(t.world:get(plot, t.money)).to.equal(9)
		end)

		it("leaves no entity state for a rejected child pair under an unlinked parent", function()
			local t = utils.create_fixture({ pull_interval = never })
			local k = declare(t)
			utils.link_entity(t, "p1")
			local stranger = t.world:entity()
			local sword = t.world:entity()
			t.world:add(sword, k.item)
			t.world:set(sword, t.money, 1)
			expect(function()
				miumiu.batch(t.world, function()
					t.world:add(sword, jecs.pair(k.owns, stranger))
				end)
			end).to.throw("not loaded")
			expect(t.world:has(sword, jecs.pair(k.owns, stranger))).to.equal(false)
			expect(state.get(t.world).entities[sword]).to.equal(nil)
		end)

		it("rejects a second child with an id already held under the parent", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local first = make_container(t, k, "plot")
			t.world:add(first, jecs.pair(k.holds, player))
			local second = make_container(t, k, "plot")
			expect(function()
				t.world:add(second, jecs.pair(k.holds, player))
			end).to.throw("already holds it under the same parent")
			expect(t.world:has(second, jecs.pair(k.holds, player))).to.equal(false)
			t.world:remove(first, jecs.pair(k.holds, player))
			expect(function()
				t.world:set(second, t.money, 3)
			end).never.to.throw()
			local sword = give(t, k, player, 1)
			local clone = t.world:entity()
			t.world:set(clone, miumiu.child_id, id_of(t, sword))
			t.world:add(clone, k.item)
			expect(function()
				t.world:add(clone, jecs.pair(k.owns, player))
			end).to.throw("already holds it under the same parent")
			t.world:delete(sword)
			expect(function()
				t.world:set(clone, t.money, 3)
			end).never.to.throw()
		end)

		it("warns and skips an existing child whose id another child under the parent already holds", function()
			local t = utils.create_fixture({ pull_interval = never })
			local k = declare(t)
			local player = t.world:entity()
			local first = make_container(t, k, "plot")
			t.world:add(first, jecs.pair(k.holds, player))
			local second = make_container(t, k, "plot")
			t.world:add(second, jecs.pair(k.holds, player))
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect(utils.warned(t.backend, "already holds under the same parent and is not indexed")).to.equal(true)
			local index = state.get(t.world).children
			expect((index.by_entity[first] == nil) ~= (index.by_entity[second] == nil)).to.equal(true)
		end)

		it("supplies a claim from the holding collection when another link is shallow", function()
			local t, k = setup()
			local other = utils.create_collection(t.world, t.backend, { pull_interval = never })
			t.world:set(other, miumiu.collection, `{t.backend.name}_other`)
			utils.scope(t.world, { t.items }, { other })
			t.backend:seed("p1", { data = { containers = { plot = { money = 7 } } } })
			local player = t.world:entity()
			t.world:add(player, jecs.pair(miumiu.data_shallow, other))
			t.world:set(player, t.link, "p1")
			t.world:set(player, jecs.pair(miumiu.data_link, other), "p1")
			settle(t, player)
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				return t.world:has(player, jecs.pair(miumiu.data_loaded, other))
			end)).to.equal(true)
			local plot = make_container(t, k, "plot")
			t.world:add(plot, jecs.pair(k.holds, player))
			expect(t.world:get(plot, t.money)).to.equal(7)
		end)

		it("holds children through the link of a root that also carries a kind tag", function()
			local t, k = setup()
			local player = utils.link_entity(t, "p1")
			local plot = make_container(t, k, "plot")
			t.world:set(plot, t.link, "plot-1")
			settle(t, plot)
			t.world:add(plot, jecs.pair(k.holds, player))
			local sword = give(t, k, plot, 3)
			expect(id_of(t, sword)).to.be.ok()
			utils.session_of(t, "plot-1"):sync()
			expect(t.backend:dump("plot-1").data.inventory[id_of(t, sword)].money).to.equal(3)
		end)

		it("keeps the other collection's lazy mark when one collection is wiped", function()
			local t = utils.create_fixture({ pull_interval = never })
			local other = utils.create_collection(t.world, t.backend, { pull_interval = never })
			t.world:set(other, miumiu.collection, `{t.backend.name}_other`)
			local battery = utils.declare_saveable(t.world, "component", "battery", { other })
			t.world:add(battery, miumiu.lazy)
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			t.world:set(player, jecs.pair(miumiu.data_link, other), "p1")
			settle(t, player)
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				return t.world:has(player, jecs.pair(miumiu.data_loaded, other))
			end)).to.equal(true)
			t.world:set(player, battery, 5)
			local second = miumiu.get_session(t.world, other, "p1")
			assert(second)
			miumiu.wipe(t.world, t.player_data, "p1")
			second:sync()
			local store = t.backend.service:GetDataStore(`{t.backend.name}_other`)
			expect(store:GetAsync("p1").data.battery).to.equal(5)
		end)
	end)
end
