return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local jecs = require(ReplicatedStorage.Packages.jecs)
	local miumiu = require(ReplicatedStorage.Packages.miumiu)
	local state = require(ReplicatedStorage.Packages.miumiu.state)
	local utils = require(ReplicatedStorage.Tests.utils)

	afterEach(utils.cleanup)

	local never = utils.timings.never

	local setup = utils.create_fixture
	local settle = utils.settle

	local other_server = utils.other_server

	describe("writes", function()
		it("journal component sets and reach the record", function()
			local t = setup()
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 9)
			expect(utils.wait_until(function()
				local record = t.backend:dump("p1")
				return record ~= nil and record.data.money == 9
			end)).to.equal(true)
			expect(t.backend:dump("p1").stamps.money > 0).to.equal(true)
		end)

		it("journal tags as booleans and removals as remove", function()
			local t = setup()
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:add(player, t.tutorial)
			t.world:set(player, t.money, 3)
			expect(utils.wait_until(function()
				local record = t.backend:dump("p1")
				return record ~= nil and record.data.tutorial == true and record.data.money == 3
			end)).to.equal(true)
			t.world:remove(player, t.tutorial)
			t.world:remove(player, t.money)
			expect(utils.wait_until(function()
				local record = t.backend:dump("p1")
				return record.data.tutorial == false and record.data.money == nil
			end)).to.equal(true)
			expect(t.backend:dump("p1").stamps.money > 0).to.equal(true)
		end)

		it("ignore writes before loaded", function()
			local t = setup({ pull_interval = never })
			t.backend:delay_next("GetAsync", utils.timings.short, "before")
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			miumiu.step(t.world)
			t.world:set(player, t.money, 1)
			settle(t, player)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
			expect(t.world:get(player, t.money)).to.equal(1)
		end)

		it("ignore writes on unlinked entities", function()
			local t = setup()
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local stranger = t.world:entity()
			t.world:set(stranger, t.money, 42)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
		end)

		it("do not journal removals caused by delete", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 3)
			local loaded = utils.session_of(t, "p1")
			loaded:sync()
			t.world:delete(player)
			miumiu.step(t.world)
			expect(utils.wait_until(function()
				return not loaded:is_open()
			end)).to.equal(true)
			expect(t.backend:dump("p1").data.money).to.equal(3)
		end)
	end)

	describe("shared key", function()
		it("two entities share one session and see each other", function()
			local t = setup()
			local a = t.world:entity()
			local b = t.world:entity()
			t.world:set(a, t.link, "p1")
			t.world:set(b, t.link, "p1")
			settle(t, a)
			settle(t, b)
			t.world:set(a, t.money, 4)
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				return t.world:get(b, t.money) == 4
			end)).to.equal(true)
		end)
	end)

	describe("remote changes", function()
		it("are reconciled onto the entity without re-journaling", function()
			local t = setup()
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local remote = other_server(t, "p1")
			utils.journal(remote, { utils.set("money", 9, os.time()) })
			remote:sync()
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				return t.world:get(player, t.money) == 9
			end)).to.equal(true)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
			task.wait(utils.timings.grace)
			expect(t.backend:dump("p1").version).to.equal(1)
			remote:unload()
		end)

		it("remove components removed elsewhere", function()
			local t = setup()
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 2)
			t.world:add(player, t.tutorial)
			expect(utils.wait_until(function()
				local record = t.backend:dump("p1")
				return record ~= nil and record.data.money == 2
			end)).to.equal(true)
			local remote = other_server(t, "p1")
			utils.journal(remote, {
				utils.remove("money", os.time() + 1),
				utils.set("tutorial", false, os.time() + 1),
			})
			remote:sync()
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				return not t.world:has(player, t.money) and not t.world:has(player, t.tutorial)
			end)).to.equal(true)
			remote:unload()
		end)

		it("keep component references when nothing changed", function()
			local t = setup()
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local list = { "a" }
			t.world:set(player, t.items, list)
			expect(utils.wait_until(function()
				local record = t.backend:dump("p1")
				return record ~= nil and record.data.items ~= nil
			end)).to.equal(true)
			expect(utils.wait_until(function()
				return utils.session_of(t, "p1"):get_pulls() >= 3
			end)).to.equal(true)
			miumiu.step(t.world)
			expect(t.world:get(player, t.items)).to.equal(list)
		end)
	end)

	describe("regressions", function()
		it("keeps a lazy write made after a write until its flush", function()
			local t = setup({ pull_interval = never })
			local battery = utils.declare_saveable(t.world, "component", "battery", { t.player_data })
			t.world:add(battery, miumiu.lazy)
			local player = utils.link_entity(t, "p1")
			local session = utils.session_of(t, "p1")
			t.world:set(player, battery, 5)
			session:sync()
			expect(t.backend:dump("p1").data.battery).to.equal(5)
			t.world:set(player, battery, 6)
			miumiu.step(t.world)
			expect(t.world:get(player, battery)).to.equal(6)
			session:sync()
			expect(t.backend:dump("p1").data.battery).to.equal(6)
		end)

		it("journals a write into every collection an entity links", function()
			local t = setup({ pull_interval = never })
			local other = utils.create_collection(t.world, t.backend, { pull_interval = never })
			t.world:set(other, miumiu.collection, `{t.backend.name}_other`)
			utils.scope(t.world, { t.money, t.items, t.tutorial }, { other })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			t.world:set(player, jecs.pair(miumiu.data_link, other), "p1")
			settle(t, player)
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				return t.world:has(player, jecs.pair(miumiu.data_loaded, other))
			end)).to.equal(true)
			t.world:set(player, t.money, 3)
			utils.session_of(t, "p1"):sync()
			local second = miumiu.get_session(t.world, other, "p1")
			assert(second)
			second:sync()
			expect(t.backend:dump("p1").data.money).to.equal(3)
			expect(t.backend.service:GetDataStore(`{t.backend.name}_other`):GetAsync("p1").data.money).to.equal(3)
		end)

		it("leaves no entity state for an unlinked entity that carried a saveable", function()
			local t = setup({ pull_interval = never })
			utils.link_entity(t, "p1")
			local npc = t.world:entity()
			t.world:set(npc, t.money, 3)
			t.world:remove(npc, t.money)
			t.world:set(npc, t.money, 4)
			t.world:delete(npc)
			expect(state.get(t.world).entities[npc]).to.equal(nil)
		end)

		it("coalesces consecutive sets of one key into one group", function()
			local t = setup({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 1 })
			local session = utils.session_of(t, "p1")
			for value = 2, 50 do
				t.world:set(player, t.money, value)
			end
			t.world:set(player, t.items, { "a" })
			t.world:set(player, t.money, 51)
			local count = utils.count(t.backend:dump("p1").landed)
			session:sync()
			expect(utils.count(t.backend:dump("p1").landed)).to.equal(count + 3)
			expect(t.backend:dump("p1").data.money).to.equal(51)
		end)

		it("delta on an initial value writes the initial first", function()
			local t = setup({ pull_interval = never })
			t.world:set(t.money, t.money, 100)
			t.world:set(t.items, t.items, { "starter" })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			miumiu
				.delta(t.world, function()
					t.world:set(player, t.money, 150)
					local items = table.clone(t.world:get(player, t.items))
					table.insert(items, "sword")
					t.world:set(player, t.items, items)
				end)
				:await()
			local record = t.backend:dump("p1")
			expect(record.data.money).to.equal(150)
			expect(table.concat(record.data.items, ",")).to.equal("starter,sword")
			miumiu.step(t.world)
			expect(t.world:get(player, t.money)).to.equal(150)
		end)

		it("guard rejection names the type and leaves the previous value or none", function()
			local t = setup({ pull_interval = never })
			t.world:set(t.money, miumiu.guard, function(value)
				return type(value) == "number"
			end)
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 3)
			expect(function()
				t.world:set(player, t.money, "many")
			end).to.throw("got string")
			expect(t.world:get(player, t.money)).to.equal(3)
			local fresh = t.world:entity()
			t.world:set(fresh, t.link, "p2")
			settle(t, fresh)
			expect(function()
				t.world:set(fresh, t.money, "nope")
			end).to.throw("failed its guard")
			expect(t.world:has(fresh, t.money)).to.equal(false)
		end)

		it("a remote write on another key keeps table references", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local list = { "a" }
			t.world:set(player, t.items, list)
			utils.session_of(t, "p1"):sync()
			local remote = other_server(t, "p1")
			utils.journal(remote, { utils.add("money", 1) })
			remote:sync()
			utils.session_of(t, "p1"):sync()
			miumiu.step(t.world)
			expect(t.world:get(player, t.money)).to.equal(1)
			expect(t.world:get(player, t.items)).to.equal(list)
			remote:unload()
		end)

		it("warns once for a rejected stored value", function()
			local t = setup({ pull_interval = never })
			t.world:set(t.money, miumiu.guard, function(value)
				return type(value) == "number"
			end)
			t.backend:seed("p1", { data = { money = "lots" } })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local count = #t.backend.warnings
			utils.session_of(t, "p1"):sync()
			miumiu.step(t.world)
			utils.session_of(t, "p1"):sync()
			miumiu.step(t.world)
			expect(#t.backend.warnings).to.equal(count)
		end)

		it("drops a pulled event for a session that closed meanwhile", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local loaded = utils.session_of(t, "p1")
			t.world:remove(player, t.link)
			local remote = other_server(t, "p1")
			utils.journal(remote, { utils.set("money", 9, os.time()) })
			remote:sync()
			loaded:sync()
			miumiu.step(t.world)
			expect(loaded:is_open()).to.equal(false)
			expect(t.world:has(player, t.money)).to.equal(false)
			remote:unload()
		end)

		it("skips reconciling an entity deleted while a pull was queued", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local remote = other_server(t, "p1")
			utils.journal(remote, { utils.set("money", 9, os.time()) })
			remote:sync()
			utils.session_of(t, "p1"):sync()
			t.world:delete(player)
			miumiu.step(t.world)
			expect(t.world:contains(player)).to.equal(false)
			remote:unload()
		end)

		it("propagates a listener error during reconcile and resets applying", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:added(t.money, function()
				error("listener boom")
			end)
			local remote = other_server(t, "p1")
			utils.journal(remote, { utils.set("money", 9, os.time()) })
			remote:sync()
			utils.session_of(t, "p1"):sync()
			expect(function()
				miumiu.step(t.world)
			end).to.throw("listener boom")
			expect(t.world:get(player, t.money)).to.equal(9)
			miumiu
				.delta(t.world, function()
					t.world:set(player, t.money, 10)
				end)
				:await()
			expect(t.backend:dump("p1").data.money).to.equal(10)
			remote:unload()
		end)

		it("journals a write a listener makes while another key is reconciled", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:added(t.money, function(entity)
				t.world:set(entity, t.items, { "bonus" })
			end)
			local remote = other_server(t, "p1")
			utils.journal(remote, { utils.set("money", 9, os.time()) })
			remote:sync()
			utils.session_of(t, "p1"):sync()
			miumiu.step(t.world)
			expect(t.world:get(player, t.items)[1]).to.equal("bonus")
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(true)
			utils.session_of(t, "p1"):sync()
			expect(t.backend:dump("p1").data.items[1]).to.equal("bonus")
			remote:unload()
		end)

		it("converges a first delta on an initial value from two servers", function()
			local t = setup({ pull_interval = never })
			t.world:set(t.money, t.money, 100)
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local remote = other_server(t, "p1")
			utils.journal(remote, { { kind = "init", key = "money", value = 100 }, utils.add("money", 5) })
			remote:sync()
			expect(t.backend:dump("p1").data.money).to.equal(105)
			miumiu
				.delta(t.world, function()
					t.world:set(player, t.money, 105)
				end)
				:await()
			expect(t.backend:dump("p1").data.money).to.equal(110)
			miumiu.step(t.world)
			expect(t.world:get(player, t.money)).to.equal(110)
			remote:unload()
		end)

		it("rejects a guard that yields and keeps the previous value", function()
			local t = setup({ pull_interval = never })
			t.world:set(t.money, miumiu.guard, function()
				task.wait()
				return true
			end)
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect(function()
				t.world:set(player, t.money, 3)
			end).to.throw("yielded")
			expect(t.world:has(player, t.money)).to.equal(false)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
		end)

		it("keeps the outer applying mark across a nested restore", function()
			local t = setup({ pull_interval = never })
			t.world:set(t.items, miumiu.guard, function(value)
				return type(value) == "table"
			end)
			t.world:changed(t.money, function(entity)
				pcall(function()
					t.world:set(entity, t.items, "not a list")
				end)
			end)
			local player = utils.link_entity(t, "p1", { money = 1 })
			local remote = other_server(t, "p1")
			utils.journal(remote, { utils.set("money", 9, os.time() + 5) })
			remote:sync()
			utils.session_of(t, "p1"):sync()
			miumiu.step(t.world)
			expect(t.world:get(player, t.money)).to.equal(9)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
			remote:unload()
		end)

		it("does not resurrect a removed key through init", function()
			local t = setup({ pull_interval = never })
			t.world:set(t.money, t.money, 100)
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local remote = other_server(t, "p1")
			utils.journal(remote, { utils.remove("money", os.time()) })
			remote:sync()
			utils.session_of(t, "p1"):sync()
			miumiu
				.delta(t.world, function()
					t.world:set(player, t.money, 105)
				end)
				:await()
			expect(t.backend:dump("p1").data.money).to.equal(5)
			remote:unload()
		end)

		it("forgets the supplied memo on a local write so a lost write is corrected", function()
			local t = setup({ pull_interval = never })
			t.backend:seed("p1", { data = { money = 7 }, stamps = { money = 1 } })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 5)
			local remote = other_server(t, "p1")
			utils.journal(remote, { utils.set("money", 7, os.time() + 5) })
			remote:sync()
			utils.session_of(t, "p1"):sync()
			miumiu.step(t.world)
			expect(t.backend:dump("p1").data.money).to.equal(7)
			expect(t.world:get(player, t.money)).to.equal(7)
			remote:unload()
		end)

		it("does not journal a set of the value the entity already holds", function()
			local t = setup({ pull_interval = never })
			local list = { "a" }
			local player = utils.link_entity(t, "p1", { items = list })
			t.world:set(player, t.items, list)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
			t.world:set(player, t.items, { "a" })
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(true)
		end)

		it("a plain set on the player's server overwrites a concurrent delta gift", function()
			local t = setup({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 10 })
			local remote = other_server(t, "p1")
			utils.journal(remote, { utils.add("money", 5) })
			remote:sync()
			t.world:set(player, t.money, 11)
			utils.session_of(t, "p1"):sync()
			expect(t.backend:dump("p1").data.money).to.equal(11)
			miumiu
				.delta(t.world, function()
					t.world:set(player, t.money, 12)
				end)
				:await()
			utils.journal(remote, { utils.add("money", 5) })
			remote:sync()
			utils.session_of(t, "p1"):sync()
			expect(t.backend:dump("p1").data.money).to.equal(17)
			remote:unload()
		end)

		it("journals a remove per saveable on world:clear", function()
			local t = setup({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 3 })
			t.world:add(player, t.tutorial)
			utils.session_of(t, "p1"):sync()
			t.world:clear(player)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(true)
			utils.session_of(t, "p1"):sync()
			expect(t.backend:dump("p1").data.money).to.equal(nil)
			expect(t.backend:dump("p1").data.tutorial).to.equal(false)
		end)

		it("does not run a second step while a listener yields inside the first", function()
			local t = setup({ pull_interval = never })
			t.backend:seed("p2", { data = { money = 1 } })
			local depth, deepest = 0, 0
			local fired, nested = false, false
			t.world:added(miumiu.data_loaded, function(_, id)
				if id ~= t.loaded or fired then
					return
				end
				fired = true
				depth += 1
				deepest = math.max(deepest, depth)
				local other = t.world:entity()
				t.world:set(other, t.link, "p2")
				miumiu.step(t.world)
				nested = utils.link_state(t, "p2") ~= nil
				utils.wait_until(function()
					return #utils.events(t) > 0
				end)
				miumiu.step(t.world)
				depth -= 1
			end)
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect(deepest).to.equal(1)
			expect(nested).to.equal(false)
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				return utils.link_state(t, "p2") ~= nil and t.backend.calls.GetAsync == 2
			end)).to.equal(true)
		end)

		it("bumps a same-second write against a stamp adopted while the commit store was being read", function()
			local t = setup({ pull_interval = never })
			local config = utils.create_config(t.backend)
			local id = utils.fresh_id("commit")
			local player = utils.link_entity(t, "p1", { money = 1 })
			local session = utils.session_of(t, "p1")
			local now = os.time()
			session:get_truth()
			t.backend:seed("p1", {
				data = { money = 1 },
				stamps = { money = now + 5 },
				pending = { [id] = { created = now, ops = { utils.add("gems", 1) } } },
			})
			utils.commit_store(t.backend, config):SetAsync(id, true)
			t.backend:delay_next("GetAsync", utils.timings.in_flight, "before", 1)
			local done = false
			task.spawn(function()
				session:sync()
				done = true
			end)
			expect(utils.wait_until(function()
				return t.backend.calls.GetAsync == 3
			end)).to.equal(true)
			t.world:set(player, t.money, 7)
			expect(utils.wait_until(function()
				return done
			end)).to.equal(true)
			session:sync()
			expect(t.backend:dump("p1").data.money).to.equal(7)
			expect(t.backend:dump("p1").stamps.money).to.equal(now + 6)
		end)

		it("a throwing serialize rejects the write and keeps the previous value", function()
			local t = setup({ pull_interval = never })
			local codes = utils.declare_saveable(t.world, "component", "codes", { t.player_data })
			t.world:set(codes, miumiu.guard, function()
				return true
			end)
			t.world:set(codes, miumiu.serdes, {
				serialize = function(set)
					if set.bad then
						error("cannot serialize")
					end
					return { "ok" }
				end,
				deserialize = function()
					return { good = true }
				end,
			})
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local first = { good = true }
			t.world:set(player, codes, first)
			expect(function()
				t.world:set(player, codes, { bad = true })
			end).to.throw("cannot serialize")
			expect(t.world:get(player, codes)).to.equal(first)
			utils.session_of(t, "p1"):sync()
			expect(t.backend:dump("p1").data.codes[1]).to.equal("ok")
			miumiu.step(t.world)
			expect(t.world:get(player, codes)).to.equal(first)
		end)
	end)
end
