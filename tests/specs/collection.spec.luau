return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local collection = require(ReplicatedStorage.Packages.miumiu.collection)
	local jecs = require(ReplicatedStorage.Packages.jecs)
	local miumiu = require(ReplicatedStorage.Packages.miumiu)
	local utils = require(ReplicatedStorage.Tests.utils)

	local fake_lapis = { createCollection = function() end }

	describe("collection.resolve_config", function()
		it("requires the collection id", function()
			local world = jecs.world()
			local entity = world:entity()
			world:set(entity, jecs.Name, "player")
			expect(function()
				collection.resolve_config(world, entity)
			end).to.throw("is not a collection")
		end)

		it("requires a store name string", function()
			local world = jecs.world()
			local entity = world:entity()
			world:set(entity, jecs.Name, "player")
			world:add(entity, miumiu.collection)
			expect(function()
				collection.resolve_config(world, entity)
			end).to.throw("has no name")
			world:set(entity, miumiu.collection, "")
			expect(function()
				collection.resolve_config(world, entity)
			end).to.throw("has no name")
		end)

		it("names from the collection value, ignoring Name", function()
			local world = jecs.world()
			local backend = utils.create_backend()
			local entity = world:entity()
			world:set(entity, jecs.Name, "player")
			world:set(entity, miumiu.collection, "player-v2")
			world:set(entity, miumiu.config, { data_store_service = backend.service })
			expect(collection.resolve_config(world, entity).name).to.equal("player-v2")
		end)

		it("keeps idle_interval at its default and never under pull_interval", function()
			local world = jecs.world()
			local backend = utils.create_backend()
			local entity = world:entity()
			world:set(entity, miumiu.collection, "player")
			world:set(entity, miumiu.config, { data_store_service = backend.service })
			expect(collection.resolve_config(world, entity).idle_interval).to.equal(60)
			world:set(entity, miumiu.config, { data_store_service = backend.service, pull_interval = 120 })
			expect(collection.resolve_config(world, entity).idle_interval).to.equal(120)
		end)

		it("fills defaults without a config", function()
			local world = jecs.world()
			local backend = utils.create_backend()
			local entity = world:entity()
			world:set(entity, miumiu.collection, "player")
			world:set(entity, miumiu.config, { data_store_service = backend.service })
			local config = collection.resolve_config(world, entity)
			expect(config.pull_interval).to.equal(15)
			expect(config.retry_attempts).to.equal(5)
			expect(config.retry_base).to.equal(1)
			expect(config.commit_store).to.equal("miumiu_commits")
			expect(config.commit_timeout).to.equal(300)
			expect(config.data_store_service).to.equal(backend.service)
			expect(#config.migrations).to.equal(0)
			expect(config.foreign).to.equal(nil)
		end)

		it("keeps overrides and migrations", function()
			local world = jecs.world()
			local backend = utils.create_backend()
			local entity = utils.create_collection(world, backend, { commit_timeout = 7 })
			local migration = function() end
			world:set(entity, miumiu.migrations, { migration })
			local config = collection.resolve_config(world, entity)
			expect(config.pull_interval).to.equal(utils.timings.pull_interval)
			expect(config.commit_timeout).to.equal(7)
			expect(config.migrations[1]).to.equal(migration)
		end)

		it("accepts a lapis source", function()
			local world = jecs.world()
			local backend = utils.create_backend()
			local entity = utils.create_collection(world, backend)
			local foreign = { type = "lapis", name = "OldStore", source = fake_lapis, options = { defaultData = {} } }
			world:set(entity, miumiu.from_foreign, foreign)
			expect(collection.resolve_config(world, entity).foreign).to.equal(foreign)
		end)

		it("rejects a foreign store that is its own store", function()
			local world = jecs.world()
			local backend = utils.create_backend()
			local entity = utils.create_collection(world, backend)
			world:set(entity, miumiu.from_foreign, {
				type = "lapis",
				name = backend.name,
				source = fake_lapis,
				options = {},
			})
			expect(function()
				collection.resolve_config(world, entity)
			end).to.throw("its own store")
		end)

		it("rejects a foreign source without type, name, library or options", function()
			local world = jecs.world()
			local backend = utils.create_backend()
			local entity = utils.create_collection(world, backend)
			world:set(
				entity,
				miumiu.from_foreign,
				{ type = "profileservice", name = "x", source = fake_lapis, options = {} }
			)
			expect(function()
				collection.resolve_config(world, entity)
			end).to.throw("unknown foreign type")
			world:set(entity, miumiu.from_foreign, { type = "lapis", name = "", source = fake_lapis, options = {} })
			expect(function()
				collection.resolve_config(world, entity)
			end).to.throw("no name")
			world:set(entity, miumiu.from_foreign, { type = "lapis", name = "x", source = {}, options = {} })
			expect(function()
				collection.resolve_config(world, entity)
			end).to.throw("not the lapis library")
			world:set(entity, miumiu.from_foreign, { type = "lapis", name = "x", source = fake_lapis })
			expect(function()
				collection.resolve_config(world, entity)
			end).to.throw("options")
		end)
	end)

	describe("collection.resolve_config validation", function()
		it("rejects numbers out of range and an empty commit store", function()
			local world = jecs.world()
			local backend = utils.create_backend()
			local entity = world:entity()
			world:set(entity, miumiu.collection, "player")
			local function with(config)
				config.data_store_service = backend.service
				world:set(entity, miumiu.config, config)
				return function()
					collection.resolve_config(world, entity)
				end
			end
			expect(with({ pull_interval = 0 })).to.throw("pull_interval must be a number greater than 0")
			expect(with({ pull_interval = 0 / 0 })).to.throw("pull_interval")
			expect(with({ retry_attempts = 0 })).to.throw("retry_attempts must be a number at least 1")
			expect(with({ retry_base = -1 })).to.throw("retry_base must be a number at least 0")
			expect(with({ commit_timeout = 0 })).to.throw("commit_timeout must be a number greater than 0")
			expect(with({ commit_store = "" })).to.throw("commit_store must be a non-empty string")
			expect(with({ user_ids = 5 })).to.throw("user_ids must be a function")
			expect(with({ pull_interval = 5, idle_interval = 4 })).to.throw("idle_interval must be a number at least 5")
			with({ pull_interval = 15 })()
			with({ idle_interval = math.huge })()
		end)

		it("warns when pull_interval is under the write cooldown on the real service", function()
			local world = jecs.world()
			local backend = utils.create_backend()
			local entity = world:entity()
			world:set(entity, miumiu.collection, "player")
			world:set(entity, miumiu.config, { data_store_service = backend.service, pull_interval = 5 })
			collection.resolve_config(world, entity)
			expect(#backend.warnings).to.equal(0)
			world:set(entity, miumiu.config, { pull_interval = 6 })
			collection.resolve_config(world, entity)
			expect(#backend.warnings).to.equal(0)
			world:set(entity, miumiu.config, { pull_interval = 5 })
			collection.resolve_config(world, entity)
			expect((string.find(backend.warnings[1], "write cooldown", 1, true))).to.be.ok()
		end)
	end)

	describe("collection.get", function()
		it("opens the store once and caches per collection", function()
			local world = jecs.world()
			local backend = utils.create_backend()
			local entity = utils.create_collection(world, backend)
			local first = collection.get(world, entity)
			expect(collection.get(world, entity)).to.equal(first)
			expect(first.config.name).to.equal(backend.name)
			expect(type(first.store.UpdateAsync)).to.equal("function")

			local other = utils.create_collection(world, utils.create_backend())
			expect(collection.get(world, other)).never.to.equal(first)
		end)
	end)
end
