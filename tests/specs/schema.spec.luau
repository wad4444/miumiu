return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local jecs = require(ReplicatedStorage.Packages.jecs)
	local miumiu = require(ReplicatedStorage.Packages.miumiu)
	local schema = require(ReplicatedStorage.Packages.miumiu.schema)
	local utils = require(ReplicatedStorage.Tests.utils)

	afterEach(utils.cleanup)

	type Entity<T = nil> = miumiu.Entity<T>

	local roots: { [miumiu.World]: Entity } = {}

	local function create_world(): (miumiu.World, utils.Backend)
		local backend = utils.create_backend()
		local world = jecs.world()
		roots[world] = utils.create_collection(world, backend)
		return world, backend
	end

	local function saveable_component(world, key: string?, name: string?)
		return utils.declare_saveable(world, "component", key, { roots[world] }, name)
	end

	local function saveable_tag(world, key: string)
		return utils.declare_saveable(world, "tag", key, { roots[world] })
	end

	describe("schema.create_schema", function()
		it("keys by the saveable value", function()
			local world = create_world()
			local money = saveable_component(world, "money")
			local built = schema.create_schema(world)
			expect(#built.entries).to.equal(1)
			expect(built.by_key.money.id).to.equal(money)
			expect(built.by_key.money.kind).to.equal("component")
		end)

		it("ignores Name entirely", function()
			local world = create_world()
			saveable_component(world, "cash", "money")
			local built = schema.create_schema(world)
			expect(built.by_key.cash).to.be.ok()
			expect(built.by_key.money).to.equal(nil)
		end)

		it("marks tags", function()
			local world = create_world()
			saveable_tag(world, "tutorial")
			expect(schema.create_schema(world).by_key.tutorial.kind).to.equal("tag")
		end)

		it("ignores ids without saveable", function()
			local world = create_world()
			local other = world:component()
			world:set(other, jecs.Name, "other")
			saveable_component(world, "money")
			local built = schema.create_schema(world)
			expect(#built.entries).to.equal(1)
			expect(built.by_key.other).to.equal(nil)
		end)

		it("sorts entries by key", function()
			local world = create_world()
			saveable_component(world, "zeta")
			saveable_component(world, "alpha")
			saveable_tag(world, "mid")
			local keys = {}
			for _, entry in schema.create_schema(world).entries do
				table.insert(keys, entry.key)
			end
			expect(table.concat(keys, ",")).to.equal("alpha,mid,zeta")
		end)

		it("warns once listing every component without a guard, never tags", function()
			local world, backend = create_world()
			saveable_component(world, "money")
			local guarded = saveable_component(world, "gems")
			world:set(guarded, miumiu.guard, function(value)
				return type(value) == "number"
			end)
			saveable_tag(world, "tutorial")
			schema.create_schema(world)
			expect(#backend.warnings).to.equal(1)
			expect((string.find(backend.warnings[1], "without a guard: money", 1, true))).to.be.ok()
			expect((string.find(backend.warnings[1], "gems", 1, true))).to.equal(nil)
		end)

		it("rejects a saveable with no key", function()
			local world = create_world()
			saveable_component(world, nil)
			expect(function()
				schema.create_schema(world)
			end).to.throw("has no key")
		end)

		it("rejects a key with a slash", function()
			local world = create_world()
			saveable_component(world, "a/b")
			expect(function()
				schema.create_schema(world)
			end).to.throw("cannot contain /")
		end)

		it("rejects two saveables with one key", function()
			local world = create_world()
			saveable_component(world, "money")
			saveable_component(world, "money", "coins")
			expect(function()
				schema.create_schema(world)
			end).to.throw('both store under "money"')
		end)
	end)

	describe("schema.get", function()
		it("caches per world", function()
			local world = create_world()
			saveable_component(world, "money")
			local first = schema.get(world)
			expect(schema.get(world)).to.equal(first)
			expect(#first.entries).to.equal(1)
		end)

		it("rejects a saveable declared after the build", function()
			local world = create_world()
			saveable_component(world, "money")
			local first = schema.get(world)
			expect(function()
				saveable_tag(world, "tutorial")
			end).to.throw("after the schema was built")
			expect(schema.get(world)).to.equal(first)
		end)

		it("rejects a key change after the build", function()
			local world = create_world()
			local money = saveable_component(world, "money")
			schema.get(world)
			expect(function()
				world:set(money, miumiu.saveable, "cash")
			end).to.throw("after the schema was built")
		end)

		it("rejects removing a saveable after the build", function()
			local world = create_world()
			local money = saveable_component(world, "money")
			schema.get(world)
			expect(function()
				world:remove(money, miumiu.saveable)
			end).to.throw("after the schema was built")
		end)

		it("rejects migrations and a foreign source declared after the build", function()
			local world = create_world()
			saveable_component(world, "money")
			schema.get(world)
			expect(function()
				world:set(roots[world], miumiu.migrations, {})
			end).to.throw("after the schema was built")
			expect(function()
				world:set(roots[world], miumiu.from_foreign, { type = "lapis" })
			end).to.throw("after the schema was built")
		end)

		it("leaves other worlds alone", function()
			local world = create_world()
			saveable_component(world, "money")
			schema.get(world)
			local other = create_world()
			saveable_component(other, "money")
			expect(#schema.get(other).entries).to.equal(1)
		end)
	end)

	describe("child kinds", function()
		it("rejects bad child configs and clashing keys", function()
			local world = jecs.world()
			local backend = utils.create_backend()
			local owns = world:entity()
			world:add(owns, jecs.Exclusive)
			local function kind(config)
				local tag = world:entity()
				world:set(tag, miumiu.child, config)
				return tag
			end
			local bad = kind({ via = owns, key = "", mode = "owned" })
			expect(function()
				schema.create_schema(world)
			end).to.throw("key must be a non-empty string")
			world:remove(bad, miumiu.child)
			local on_component = world:component()
			world:set(on_component, miumiu.child, { via = owns, key = "parts", mode = "owned" })
			expect(function()
				schema.create_schema(world)
			end).to.throw("must be declared on a tag")
			world:remove(on_component, miumiu.child)
			bad = kind({ via = owns, key = "x", mode = "borrowed" })
			expect(function()
				schema.create_schema(world)
			end).to.throw("mode must be")
			world:remove(bad, miumiu.child)
			bad = kind({ via = "nope", key = "x", mode = "owned" })
			expect(function()
				schema.create_schema(world)
			end).to.throw("via must be a relation")
			world:remove(bad, miumiu.child)
			local plain = world:entity()
			bad = kind({ via = plain, key = "x", mode = "owned" })
			expect(function()
				schema.create_schema(world)
			end).to.throw("jecs.Exclusive")
			world:remove(bad, miumiu.child)
			bad = kind({ via = owns, key = "x", mode = "attached" })
			expect(function()
				schema.create_schema(world)
			end).to.throw("needs an id component")
			world:remove(bad, miumiu.child)
			bad = kind(7)
			expect(function()
				schema.create_schema(world)
			end).to.throw("must be a table")
			world:remove(bad, miumiu.child)
			local stray = utils.declare_saveable(world, "component", "stray", { owns })
			expect(function()
				schema.create_schema(world)
			end).to.throw("neither a collection nor a child kind")
			world:remove(stray, miumiu.saveable)
			bad = kind({ via = owns, key = "a/b", mode = "owned" })
			expect(function()
				schema.create_schema(world)
			end).to.throw("without /")
			world:remove(bad, miumiu.child)

			utils.declare_saveable(world, "component", "items", {})
			bad = kind({ via = owns, key = "items", mode = "owned" })
			expect(function()
				schema.create_schema(world)
			end).to.throw("already uses")
			world:remove(bad, miumiu.child)
			kind({ via = owns, key = "things", mode = "owned" })
			bad = kind({ via = owns, key = "things", mode = "owned" })
			expect(function()
				schema.create_schema(world)
			end).to.throw("already uses")
			world:remove(bad, miumiu.child)

			local tag = utils.declare_saveable(world, "tag", "flag", {})
			world:set(tag, miumiu.snapshot, function()
				return true
			end)
			expect(function()
				schema.create_schema(world)
			end).to.throw("cannot carry a snapshot")
			expect(#backend.warnings).to.equal(0)
		end)

		it("rejects a kind that is a field of nothing known", function()
			local world = create_world()
			local owns = world:entity()
			world:add(owns, jecs.Exclusive)
			local tag = world:entity()
			world:set(tag, miumiu.child, { via = owns, key = "things", mode = "owned" })
			world:add(tag, jecs.pair(miumiu.field_of, owns))
			expect(function()
				schema.create_schema(world)
			end).to.throw("child kind")
			expect(function()
				schema.create_schema(world)
			end).to.throw("neither a collection nor a child kind")
		end)
	end)

	describe("scopes", function()
		it("requires a field_of pair on every saveable and kind", function()
			local world = create_world()
			local money = utils.declare_saveable(world, "component", "money", {})
			expect(function()
				schema.create_schema(world)
			end).to.throw("picks where each lives")
			local owns = world:entity()
			world:add(owns, jecs.Exclusive)
			local tag = world:entity()
			world:set(tag, jecs.Name, "things")
			world:set(tag, miumiu.child, { via = owns, key = "things", mode = "owned" })
			expect(function()
				schema.create_schema(world)
			end).to.throw('no field_of pair on saveable "money", child kind "things":')
			world:remove(money, miumiu.saveable)
			expect(function()
				schema.create_schema(world)
			end).to.throw('no field_of pair on child kind "things":')
			world:add(tag, jecs.pair(miumiu.field_of, roots[world]))
			expect(#schema.create_schema(world).kinds).to.equal(1)
		end)

		it("requires the pair with no collection declared at all", function()
			local world = jecs.world()
			utils.declare_saveable(world, "component", "money", {})
			expect(function()
				schema.create_schema(world)
			end).to.throw("picks where each lives")
		end)

		it("holds a saveable on every collection it is a field of", function()
			local world = create_world()
			local other = utils.create_collection(world, utils.create_backend())
			local shared = saveable_component(world, "shared")
			saveable_component(world, "own")
			utils.scope(world, { shared }, { other })
			local built = schema.create_schema(world)
			expect(#built.roots[roots[world]].entries).to.equal(2)
			expect(#built.roots[other].entries).to.equal(1)
			expect(built.roots[other].entries[1].id).to.equal(shared)
			expect(built.by_key.own.holders[other]).to.equal(nil)
		end)

		it("rejects a guard, serdes or snapshot that is not a function at the build", function()
			local world = create_world()
			local money = saveable_component(world, "money")
			world:set(money, miumiu.guard, true)
			expect(function()
				schema.create_schema(world)
			end).to.throw("miumiu.guard, fn")
			world:remove(money, miumiu.guard)
			world:set(money, miumiu.serdes, { serialize = function() end })
			expect(function()
				schema.create_schema(world)
			end).to.throw("takes two functions")
			world:remove(money, miumiu.serdes)
			world:set(money, miumiu.snapshot, 5)
			expect(function()
				schema.create_schema(world)
			end).to.throw("miumiu.snapshot, fn")
		end)

		it("rejects a guard or serdes on a tag", function()
			local t = utils.create_fixture({ pull_interval = utils.timings.never })
			t.world:set(t.tutorial, miumiu.guard, function()
				return true
			end)
			expect(function()
				miumiu.step(t.world)
			end).to.throw("cannot carry a guard")
			t.world:remove(t.tutorial, miumiu.guard)
			t.world:set(t.tutorial, miumiu.serdes, {
				serialize = function(value)
					return value
				end,
				deserialize = function(value)
					return value
				end,
			})
			expect(function()
				miumiu.step(t.world)
			end).to.throw("cannot carry serdes")
		end)
	end)
end
