return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local jecs = require(ReplicatedStorage.Packages.jecs)
	local util = require(ReplicatedStorage.Packages.miumiu.util)

	describe("util.describe", function()
		it("quotes a named entity and prints a bare id otherwise", function()
			local world = jecs.world()
			local named = world:entity()
			world:set(named, jecs.Name, "money")
			expect(util.describe(world, named)).to.equal('"money"')
			local bare = world:entity()
			expect(util.describe(world, bare)).to.equal(tostring(bare))
		end)
	end)

	describe("util.targets_of", function()
		it("lists every target of a relation in order", function()
			local world = jecs.world()
			local relation = world:entity()
			local a, b = world:entity(), world:entity()
			local subject = world:entity()
			world:add(subject, jecs.pair(relation, a))
			world:add(subject, jecs.pair(relation, b))
			local targets = util.targets_of(world, subject, relation)
			expect(#targets).to.equal(2)
			expect(targets[1]).to.equal(a)
			expect(targets[2]).to.equal(b)
			expect(#util.targets_of(world, world:entity(), relation)).to.equal(0)
		end)
	end)

	describe("util.sync", function()
		it("returns every value of a function that does not yield", function()
			local a, b = util.sync("guard", "k", function(x: number)
				return x, x + 1
			end, 1)
			expect(a).to.equal(1)
			expect(b).to.equal(2)
		end)

		it("rethrows an error and names a yield", function()
			expect(function()
				util.sync("guard", "k", function()
					error("boom", 0)
				end)
			end).to.throw("boom")
			expect(function()
				util.sync("serialize", "codes", function()
					task.wait()
				end)
			end).to.throw('serialize for "codes" yielded')
		end)
	end)

	describe("util.own", function()
		it("clones once and then hands back the copy", function()
			local original = { a = 1 }
			local copy = util.own(original, original)
			expect(copy).never.to.equal(original)
			expect(copy.a).to.equal(1)
			expect(util.own(original, copy)).to.equal(copy)
		end)
	end)

	describe("util.create_guard", function()
		it("keeps the first error and rethrows it", function()
			local guard = util.create_guard()
			guard.run(function() end)
			expect(guard.get_error()).to.equal(nil)
			guard.rethrow()
			guard.run(function()
				error("first", 0)
			end)
			guard.run(function()
				error("second", 0)
			end)
			expect(guard.get_error()).to.equal("first")
			expect(function()
				guard.rethrow()
			end).to.throw("first")
		end)
	end)

	describe("util.run_all and util.join_all", function()
		it("run every item and rethrow the first error afterwards", function()
			local seen = {}
			expect(function()
				util.run_all({ 1, 2, 3 }, function(item)
					table.insert(seen, item)
					if item ~= 3 then
						error(`item {item}`, 0)
					end
				end)
			end).to.throw("item 1")
			expect(#seen).to.equal(3)
			local joined = {}
			expect(function()
				util.join_all({ 1, 2 }, function(item)
					task.wait()
					table.insert(joined, item)
					error(`item {item}`, 0)
				end)
			end).to.throw("item")
			expect(#joined).to.equal(2)
			util.join_all({}, function() end)
		end)
	end)

	describe("util.cached", function()
		it("creates once per owner and name", function()
			local cache = setmetatable({}, { __mode = "k" })
			local owner = {}
			local created = 0
			local function create()
				created += 1
				return { created }
			end
			local first = util.cached(cache, owner, "a", create)
			expect(util.cached(cache, owner, "a", create)).to.equal(first)
			expect(util.cached(cache, owner, "b", create)).never.to.equal(first)
			expect(created).to.equal(2)
		end)
	end)

	describe("util.create_guid", function()
		it("makes 32 hex characters, distinct each time", function()
			local a, b = util.create_guid(), util.create_guid()
			expect(#a).to.equal(32)
			expect(string.match(a, "^%x+$")).to.be.ok()
			expect(a).never.to.equal(b)
		end)
	end)
end
