return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local jecs = require(ReplicatedStorage.Packages.jecs)
	local miumiu = require(ReplicatedStorage.Packages.miumiu)
	local utils = require(ReplicatedStorage.Tests.utils)

	afterEach(utils.cleanup)

	local never = utils.timings.never
	local session_of = utils.session_of
	local other_server = utils.other_server

	describe("batch on one key", function()
		it("writes every op as one group and returns once written", function()
			local t = utils.create_fixture({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 1 })
			miumiu
				.batch(t.world, function()
					t.world:set(player, t.money, 5)
					t.world:add(player, t.tutorial)
				end)
				:await()
			local record = t.backend:dump("p1")
			expect(record.data.money).to.equal(5)
			expect(record.data.tutorial).to.equal(true)
			expect(record.version).to.equal(2)
			expect(session_of(t, "p1"):is_dirty()).to.equal(false)
		end)

		it("does nothing when fn writes nothing", function()
			local t = utils.create_fixture({ pull_interval = never })
			utils.link_entity(t, "p1")
			local calls = t.backend.calls.UpdateAsync
			miumiu.batch(t.world, function() end):await()
			expect(t.backend.calls.UpdateAsync).to.equal(calls)
		end)

		it("rolls the world back and journals nothing when fn throws", function()
			local t = utils.create_fixture({ pull_interval = never })
			local list = { "a" }
			local player = utils.link_entity(t, "p1", { money = 1, items = list })
			t.world:add(player, t.tutorial)
			local loaded = session_of(t, "p1")
			loaded:sync()
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(player, t.money, 5)
						t.world:set(player, t.items, { "b" })
						t.world:remove(player, t.tutorial)
						t.world:remove(player, t.money)
						error("nope")
					end)
					:await()
			end).to.throw("nope")
			expect(t.world:get(player, t.money)).to.equal(1)
			expect(t.world:get(player, t.items)).to.equal(list)
			expect(t.world:has(player, t.tutorial)).to.equal(true)
			expect(loaded:is_dirty()).to.equal(false)
		end)

		it("rejects writes to an entity that is not loaded", function()
			local t = utils.create_fixture({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 1 })
			local stranger = t.world:entity()
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(player, t.money, 2)
						t.world:set(stranger, t.money, 9)
					end)
					:await()
			end).to.throw("not loaded")
			expect(t.world:get(player, t.money)).to.equal(1)
			expect(t.world:has(stranger, t.money)).to.equal(false)
			expect(session_of(t, "p1"):is_dirty()).to.equal(false)
		end)
	end)

	describe("delta", function()
		it("journals number changes as add and array appends as insert", function()
			local t = utils.create_fixture({ pull_interval = never })
			local sword = { id = "sword" }
			local player = utils.link_entity(t, "p1", { money = 10, items = { sword } })
			session_of(t, "p1"):sync()
			miumiu
				.delta(t.world, function()
					t.world:set(player, t.money, t.world:get(player, t.money) + 5)
					local items = table.clone(t.world:get(player, t.items))
					table.insert(items, { id = "bow" })
					t.world:set(player, t.items, items)
				end)
				:await()
			local record = t.backend:dump("p1")
			expect(record.data.money).to.equal(15)
			expect(#record.data.items).to.equal(2)
		end)

		it("composes with a change another server made meanwhile", function()
			local t = utils.create_fixture({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 10 })
			session_of(t, "p1"):sync()
			local remote = other_server(t, "p1")
			utils.journal(remote, { utils.add("money", 3) })
			remote:sync()
			miumiu
				.delta(t.world, function()
					t.world:set(player, t.money, t.world:get(player, t.money) + 5)
				end)
				:await()
			expect(t.backend:dump("p1").data.money).to.equal(18)
			miumiu.step(t.world)
			expect(t.world:get(player, t.money)).to.equal(18)
			remote:unload()
		end)

		it("rolls back and throws on a write that is not a delta", function()
			local t = utils.create_fixture({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 10, items = { "a" } })
			session_of(t, "p1"):sync()
			expect(function()
				miumiu
					.delta(t.world, function()
						t.world:set(player, t.money, 12)
						t.world:set(player, t.items, { "x" })
					end)
					:await()
			end).to.throw("not a delta")
			expect(t.world:get(player, t.money)).to.equal(10)
			expect(t.world:get(player, t.items)[1]).to.equal("a")
			expect(function()
				miumiu
					.delta(t.world, function()
						t.world:add(player, t.tutorial)
					end)
					:await()
			end).to.throw("not a delta")
			expect(t.world:has(player, t.tutorial)).to.equal(false)
			expect(session_of(t, "p1"):is_dirty()).to.equal(false)
		end)

		it("joins an enclosing batch", function()
			local t = utils.create_fixture({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 10 })
			session_of(t, "p1"):sync()
			local stamp = t.backend:dump("p1").stamps.money
			miumiu
				.batch(t.world, function()
					miumiu.delta(t.world, function()
						t.world:set(player, t.money, 11)
					end)
					t.world:add(player, t.tutorial)
				end)
				:await()
			local record = t.backend:dump("p1")
			expect(record.data.money).to.equal(11)
			expect(record.data.tutorial).to.equal(true)
			expect(record.stamps.tutorial).to.be.ok()
			expect(record.stamps.money).to.equal(stamp)
			expect(record.version).to.equal(2)
		end)
	end)

	describe("batch across keys", function()
		it("lands on both records through the commit store", function()
			local t = utils.create_fixture({ pull_interval = never })
			local sender = utils.link_entity(t, "p1", { money = 10 })
			local receiver = utils.link_entity(t, "p2", { money = 1 })
			miumiu
				.batch(t.world, function()
					miumiu.delta(t.world, function()
						t.world:set(sender, t.money, 6)
						t.world:set(receiver, t.money, 5)
					end)
				end)
				:await()
			expect(t.backend:dump("p1").data.money).to.equal(6)
			expect(t.backend:dump("p2").data.money).to.equal(5)
			expect(t.backend:dump("p1").pending).to.equal(nil)
			expect(t.backend:dump("p2").pending).to.equal(nil)
			expect(t.world:get(sender, t.money)).to.equal(6)
			expect(t.world:get(receiver, t.money)).to.equal(5)
			expect(session_of(t, "p1"):get_truth().money).to.equal(t.backend:dump("p1").data.money)
		end)

		it("rolls back when the commit cannot be marked", function()
			local t = utils.create_fixture({ pull_interval = never, retry_attempts = 1 })
			local sender = utils.link_entity(t, "p1", { money = 10 })
			local receiver = utils.link_entity(t, "p2", { money = 1 })
			session_of(t, "p1"):sync()
			session_of(t, "p2"):sync()
			t.backend:fail_next("SetAsync", "before", "commit down")
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(sender, t.money, 6)
						t.world:set(receiver, t.money, 5)
					end)
					:await()
			end).to.throw("commit down")
			expect(t.world:get(sender, t.money)).to.equal(10)
			expect(t.world:get(receiver, t.money)).to.equal(1)
			expect(session_of(t, "p1"):get_truth().money).to.equal(10)
			expect(session_of(t, "p1"):is_dirty()).to.equal(false)
			expect(session_of(t, "p1"):get_truth().money).to.equal(t.backend:dump("p1").data.money)
			expect(t.backend:dump("p1").data.money).to.equal(10)
			expect(t.backend:dump("p1").pending).to.be.ok()

			local started = os.time()
			expect(utils.wait_until(function()
				return os.time() - started > utils.timings.commit_timeout
			end, utils.timings.long)).to.equal(true)
			session_of(t, "p1"):sync()
			expect(t.backend:dump("p1").pending).to.equal(nil)
			expect(t.backend:dump("p1").data.money).to.equal(10)
		end)

		it("rolls back when a record cannot be written", function()
			local t = utils.create_fixture({ pull_interval = never, retry_attempts = 1 })
			local sender = utils.link_entity(t, "p1", { money = 10 })
			local receiver = utils.link_entity(t, "p2", { money = 1 })
			session_of(t, "p1"):sync()
			session_of(t, "p2"):sync()
			t.backend:fail_next("UpdateAsync", "before", "store down")
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(sender, t.money, 6)
						t.world:set(receiver, t.money, 5)
					end)
					:await()
			end).to.throw("store down")
			expect(t.world:get(sender, t.money)).to.equal(10)
			expect(t.world:get(receiver, t.money)).to.equal(1)
			expect(session_of(t, "p1"):is_dirty()).to.equal(false)
			expect(session_of(t, "p2"):is_dirty()).to.equal(false)
			expect(t.backend.calls.SetAsync).to.equal(nil)
		end)
	end)

	describe("handle", function()
		it("returns without yielding and settles the handle when the write lands", function()
			local t = utils.create_fixture({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 1 })
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			local landed = 0
			local batch = miumiu.batch(t.world, function()
				t.world:set(player, t.money, 5)
			end)
			expect(miumiu.is_batch(batch)).to.equal(true)
			expect(miumiu.is_batch(5)).to.equal(false)
			expect(batch:get_outcome().kind).to.equal("pending")
			expect(batch:is_settled()).to.equal(false)
			expect(tostring(batch)).to.equal("Batch(pending)")
			local disconnect = batch:hook(miumiu.hooks.landed, function()
				landed += 1
			end)
			batch:hook(miumiu.hooks.refused, function()
				landed -= 100
			end)
			expect(landed).to.equal(0)
			batch:await()
			expect(batch:get_outcome().kind).to.equal("landed")
			expect(batch:is_settled()).to.equal(true)
			expect(landed).to.equal(1)
			batch:hook(miumiu.hooks.landed, function()
				landed += 10
			end)
			expect(landed).to.equal(11)
			disconnect()
			batch:await()
			expect(t.backend:dump("p1").data.money).to.equal(5)
		end)

		it("reports a refused commit through the handle and rolls the world back", function()
			local t = utils.create_fixture({ pull_interval = never, retry_attempts = 1 })
			local player = utils.link_entity(t, "p1", { money = 1 })
			t.backend:fail_next("UpdateAsync", "before", "store down")
			local refused = nil
			local batch = miumiu.batch(t.world, function()
				t.world:set(player, t.money, 2)
			end)
			batch:hook(miumiu.hooks.refused, function(message)
				refused = message
			end)
			expect(function()
				batch:await()
			end).to.throw("store down")
			expect((string.find(refused, "store down"))).to.be.ok()
			expect(t.world:get(player, t.money)).to.equal(1)
			expect(batch:get_outcome().kind).to.equal("refused")
			local late = nil
			batch:hook(miumiu.hooks.refused, function(message)
				late = message
			end)
			expect(late).to.equal(refused)
			expect(utils.warned(t.backend, "refused and rolled back")).to.equal(false)
			batch:hook(miumiu.hooks.landed, function()
				error("never")
			end)
		end)

		it("settles as refused and warns with the key when rollback throws and nobody hooks refused", function()
			local t = utils.create_fixture({ pull_interval = never, retry_attempts = 1 })
			local player = utils.link_entity(t, "p1", { money = 1 })
			local disconnect = t.world:changed(t.money, function(_, _, value)
				if value == 1 then
					error("listener boom")
				end
			end)
			t.backend:fail_next("UpdateAsync", "before", "store down")
			local batch = miumiu.batch(t.world, function()
				t.world:set(player, t.money, 2)
			end)
			expect(utils.wait_until(function()
				return batch:is_settled()
			end)).to.equal(true)
			disconnect()
			expect(batch:get_outcome().kind).to.equal("refused")
			expect(utils.warned(t.backend, "threw and may be incomplete")).to.equal(true)
			expect(utils.wait_until(function()
				return utils.warned(t.backend, 'on "p1" refused and rolled back')
			end)).to.equal(true)
			expect(function()
				miumiu.batch(t.world, function()
					t.world:set(player, t.money, 3)
					error("nope")
				end)
			end).to.throw("nope")
			expect(utils.warning_count(t.backend, "threw and may be incomplete")).to.equal(1)
			local again = t.world:changed(t.money, function(_, _, value)
				if value == 2 then
					error("listener boom")
				end
			end)
			expect(function()
				miumiu.batch(t.world, function()
					t.world:set(player, t.money, 4)
					error("nope")
				end)
			end).to.throw("nope")
			again()
			expect(utils.warning_count(t.backend, "rollback of batch capture threw")).to.equal(1)
		end)

		it("hands nested calls the outer handle and warns when a hook throws", function()
			local t = utils.create_fixture({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 1 })
			local inner = nil
			local outer = miumiu.batch(t.world, function()
				inner = miumiu.delta(t.world, function()
					t.world:set(player, t.money, 2)
				end)
			end)
			expect(inner).to.equal(outer)
			outer:hook(miumiu.hooks.landed, function()
				error("hook boom")
			end)
			outer:await()
			expect(utils.warned(t.backend, "hook boom")).to.equal(true)
			expect(t.backend:dump("p1").data.money).to.equal(2)
		end)
	end)

	describe("regressions", function()
		it("keeps a write made while a commit was failing and undoes only its own", function()
			local t = utils.create_fixture({ pull_interval = never, retry_attempts = 1 })
			local player = utils.link_entity(t, "p1", { money = 1, items = { "a" } })
			local session = session_of(t, "p1")
			local writes = t.backend.calls.UpdateAsync
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			t.backend:fail_next("UpdateAsync", "before", "store down")
			local batch = miumiu.batch(t.world, function()
				t.world:set(player, t.money, 2)
				t.world:set(player, t.items, { "b" })
			end)
			expect(utils.wait_until(function()
				return t.backend.calls.UpdateAsync > writes
			end)).to.equal(true)
			t.world:set(player, t.money, 7)
			expect(utils.wait_until(function()
				return batch:is_settled()
			end)).to.equal(true)
			expect(batch:get_outcome().kind).to.equal("refused")
			expect(t.world:get(player, t.money)).to.equal(7)
			expect(t.world:get(player, t.items)[1]).to.equal("a")
			session:sync()
			expect(t.backend:dump("p1").data.money).to.equal(7)
			expect(t.backend:dump("p1").data.items[1]).to.equal("a")
		end)

		it("records a lazy saveable like any write inside batch and refuses it inside delta", function()
			local t = utils.create_fixture({ pull_interval = never })
			local battery = utils.declare_saveable(t.world, "component", "battery")
			t.world:add(battery, miumiu.lazy)
			local player = utils.link_entity(t, "p1", { money = 1 })
			local session = session_of(t, "p1")
			miumiu
				.batch(t.world, function()
					t.world:set(player, battery, 4)
				end)
				:await()
			expect(t.backend:dump("p1").data.battery).to.equal(4)
			expect(session:is_dirty()).to.equal(false)
			expect(function()
				miumiu
					.delta(t.world, function()
						t.world:set(player, battery, 5)
					end)
					:await()
			end).to.throw("lazy")
			expect(t.world:get(player, battery)).to.equal(4)
			expect(session:is_dirty()).to.equal(false)
		end)

		it("keeps a child's pre-attach value when a batch that changes it fails", function()
			local t = utils.create_fixture({ pull_interval = never })
			local owns = t.world:entity()
			t.world:add(owns, jecs.Exclusive)
			local item = t.world:entity()
			t.world:set(item, miumiu.child, { via = owns, key = "inventory", mode = "owned" })
			utils.scope(t.world, { t.money }, { t.player_data, item })
			local player = utils.link_entity(t, "p1")
			local sword = t.world:entity()
			t.world:add(sword, item)
			t.world:set(sword, t.money, 10)
			t.world:add(sword, jecs.pair(owns, player))
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(sword, t.money, 5)
						error("boom")
					end)
					:await()
			end).to.throw("boom")
			expect(t.world:get(sword, t.money)).to.equal(10)
		end)

		it("rolls back a single-key batch whose write fails", function()
			local t = utils.create_fixture({ pull_interval = never, retry_attempts = 1 })
			local player = utils.link_entity(t, "p1", { money = 1 })
			t.backend:fail_next("UpdateAsync", "before", "store down")
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(player, t.money, 2)
					end)
					:await()
			end).to.throw("store down")
			expect(t.world:get(player, t.money)).to.equal(1)
			expect(session_of(t, "p1"):is_dirty()).to.equal(false)
		end)

		it("succeeds when a single-key write lands but the call fails", function()
			local t = utils.create_fixture({ pull_interval = never, retry_attempts = 1 })
			local player = utils.link_entity(t, "p1", { money = 1 })
			t.backend:fail_next("UpdateAsync", "after", "flaky")
			miumiu
				.batch(t.world, function()
					t.world:set(player, t.money, 2)
				end)
				:await()
			expect(t.world:get(player, t.money)).to.equal(2)
			expect(t.backend:dump("p1").data.money).to.equal(2)
			expect(session_of(t, "p1"):is_dirty()).to.equal(false)
			expect(session_of(t, "p1"):get_truth().money).to.equal(2)
		end)

		it("rolls back when a session closes before the batch commits", function()
			local t = utils.create_fixture({ pull_interval = never })
			local sender = utils.link_entity(t, "p1", { money = 10 })
			local receiver = utils.link_entity(t, "p2", { money = 1 })
			local second = session_of(t, "p2")
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(sender, t.money, 6)
						t.world:set(receiver, t.money, 5)
						second:unload()
					end)
					:await()
			end).to.throw("closed")
			expect(t.world:get(sender, t.money)).to.equal(10)
			expect(t.world:get(receiver, t.money)).to.equal(1)
			expect(session_of(t, "p1"):is_dirty()).to.equal(false)
			expect(t.backend.calls.SetAsync).to.equal(nil)
		end)

		it("skips deleted entities when rolling back", function()
			local t = utils.create_fixture({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 1 })
			local other = utils.link_entity(t, "p2", { money = 1 })
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(player, t.money, 2)
						t.world:set(other, t.money, 2)
						t.world:delete(other)
						error("nope")
					end)
					:await()
			end).to.throw("nope")
			expect(t.world:get(player, t.money)).to.equal(1)
			expect(t.world:contains(other)).to.equal(false)
		end)

		it("rolls back when the commit comes too late", function()
			local t = utils.create_fixture({ pull_interval = never, commit_timeout = utils.timings.short })
			local sender = utils.link_entity(t, "p1", { money = 10 })
			local receiver = utils.link_entity(t, "p2", { money = 1 })
			t.backend:delay_next("UpdateAsync", utils.timings.overdue, "after")
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(sender, t.money, 6)
						t.world:set(receiver, t.money, 5)
					end)
					:await()
			end).to.throw("took longer")
			expect(t.world:get(sender, t.money)).to.equal(10)
			expect(t.world:get(receiver, t.money)).to.equal(1)
			expect(t.backend.calls.SetAsync).to.equal(nil)
		end)

		it("warns when the settling pull fails after the commit", function()
			local t = utils.create_fixture({ pull_interval = never, retry_attempts = 1 })
			local sender = utils.link_entity(t, "p1", { money = 10 })
			local receiver = utils.link_entity(t, "p2", { money = 1 })
			t.backend:fail_next("UpdateAsync", "before", "settle down", 2)
			miumiu
				.batch(t.world, function()
					t.world:set(sender, t.money, 6)
					t.world:set(receiver, t.money, 5)
				end)
				:await()
			expect((string.find(t.backend.warnings[#t.backend.warnings], "settle down"))).to.be.ok()
			expect(t.world:get(sender, t.money)).to.equal(6)
			session_of(t, "p1"):sync()
			expect(t.backend:dump("p1").data.money).to.equal(6)
		end)

		it("rethrows from a nested batch and rolls everything back", function()
			local t = utils.create_fixture({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 1 })
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(player, t.money, 2)
						miumiu.batch(t.world, function()
							t.world:set(player, t.money, 3)
							error("inner")
						end)
					end)
					:await()
			end).to.throw("inner")
			expect(t.world:get(player, t.money)).to.equal(1)
			expect(session_of(t, "p1"):is_dirty()).to.equal(false)
		end)

		it("rejects a removal inside delta", function()
			local t = utils.create_fixture({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 1 })
			expect(function()
				miumiu
					.delta(t.world, function()
						t.world:remove(player, t.money)
					end)
					:await()
			end).to.throw("value removed")
			expect(t.world:get(player, t.money)).to.equal(1)
		end)

		it("rejects a batch across different commit stores", function()
			local t = utils.create_fixture({ pull_interval = never })
			local other =
				utils.create_collection(t.world, t.backend, { pull_interval = never, commit_store = "elsewhere" })
			utils.scope(t.world, { t.money, t.items, t.tutorial }, { t.player_data, other })
			local here = utils.link_entity(t, "p1", { money = 10 })
			local there = t.world:entity()
			t.world:set(there, jecs.pair(miumiu.data_link, other), "p9")
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				return t.world:has(there, jecs.pair(miumiu.data_loaded, other))
			end)).to.equal(true)
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(here, t.money, 9)
						t.world:set(there, t.money, 1)
					end)
					:await()
			end).to.throw("different data_store_service, commit_store")
			expect(t.world:get(here, t.money)).to.equal(10)
			expect(t.world:has(there, t.money)).to.equal(false)
		end)

		it("succeeds when the commit mark lands but the call fails", function()
			local t = utils.create_fixture({ pull_interval = never, retry_attempts = 1 })
			local a = utils.link_entity(t, "p1", { money = 10 })
			local b = utils.link_entity(t, "p2", { money = 0 })
			t.backend:fail_next("SetAsync", "after", "flaky")
			miumiu
				.batch(t.world, function()
					t.world:set(a, t.money, 7)
					t.world:set(b, t.money, 3)
				end)
				:await()
			expect(t.world:get(a, t.money)).to.equal(7)
			expect(t.world:get(b, t.money)).to.equal(3)
			expect(t.backend:dump("p1").data.money).to.equal(7)
			expect(t.backend:dump("p2").data.money).to.equal(3)
			expect(session_of(t, "p1"):is_dirty()).to.equal(false)
		end)

		it("undoes only an added component on an unloaded entity", function()
			local t = utils.create_fixture({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 1 })
			local npc = t.world:entity()
			t.world:set(npc, t.money, 10)
			expect(function()
				miumiu
					.batch(t.world, function()
						t.world:set(player, t.money, 2)
						t.world:set(npc, t.money, 0)
					end)
					:await()
			end).to.throw("not loaded")
			expect(t.world:get(player, t.money)).to.equal(1)
			expect(t.world:get(npc, t.money)).to.equal(0)
		end)
	end)
end
