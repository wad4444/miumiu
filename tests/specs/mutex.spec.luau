return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local mutex = require(ReplicatedStorage.Packages.miumiu.mutex)

	describe("mutex", function()
		it("runs one critical section at a time in order", function()
			local lock = mutex.create_mutex()
			local order = {}

			task.spawn(function()
				lock:with(function()
					table.insert(order, "a:start")
					task.wait()
					table.insert(order, "a:end")
				end)
			end)
			task.spawn(function()
				lock:with(function()
					table.insert(order, "b")
				end)
			end)
			lock:with(function()
				table.insert(order, "c")
			end)

			expect(table.concat(order, ",")).to.equal("a:start,a:end,b,c")
		end)

		it("skips waiters whose thread died and frees the lock when none is left", function()
			local lock = mutex.create_mutex()
			lock:lock()
			local dead = task.spawn(function()
				lock:lock()
			end)
			local ran = false
			task.spawn(function()
				lock:with(function()
					ran = true
				end)
			end)
			task.cancel(dead)
			lock:unlock()
			expect(ran).to.equal(true)

			lock:lock()
			local gone = task.spawn(function()
				lock:lock()
			end)
			task.cancel(gone)
			lock:unlock()
			expect(tostring(lock)).to.equal("Mutex(free)")
		end)

		it("close skips waiters whose thread died", function()
			local lock = mutex.create_mutex()
			lock:lock()
			local cancelled = task.spawn(function()
				lock:lock()
			end)
			task.cancel(cancelled)
			lock:close("done")
			expect(tostring(lock)).to.equal("Mutex(locked)")
		end)

		it("unlocks and rethrows when the section throws", function()
			local lock = mutex.create_mutex()
			expect(function()
				lock:with(function()
					error("inner")
				end)
			end).to.throw("inner")
			expect(tostring(lock)).to.equal("Mutex(free)")
		end)

		it("knows its own", function()
			expect(mutex.is_mutex(mutex.create_mutex())).to.equal(true)
			expect(mutex.is_mutex({})).to.equal(false)
		end)

		it("wakes waiters with the close reason", function()
			local lock = mutex.create_mutex()
			lock:lock()
			local err = nil
			task.spawn(function()
				local ok, message = pcall(function()
					lock:with(function() end)
				end)
				if not ok then
					err = message
				end
			end)
			lock:close("gone")
			expect(err).to.equal("gone")
			expect(function()
				lock:lock()
			end).to.throw("gone")
		end)
	end)
end
