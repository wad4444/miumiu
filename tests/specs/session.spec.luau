return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local commit = require(ReplicatedStorage.Packages.miumiu.commit)
	local miumiu = require(ReplicatedStorage.Packages.miumiu)
	local utils = require(ReplicatedStorage.Tests.utils)

	afterEach(utils.cleanup)

	local never = utils.timings.never
	local hooks = miumiu.hooks
	local set = utils.set
	local add = utils.add
	local fresh_id = utils.fresh_id

	describe("session.load_session", function()
		it("starts empty and writes nothing for a fresh key", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k")
			expect((next(loaded:get_truth()))).to.equal(nil)
			expect(loaded:is_open()).to.equal(true)
			expect(loaded:is_dirty()).to.equal(false)
			expect(backend:dump("k")).to.equal(nil)
			loaded:unload()
		end)

		it("loads the stored truth", function()
			local backend = utils.create_backend()
			backend:seed("k", { data = { money = 5 }, stamps = { money = 3 } })
			local loaded = utils.open_session(backend, "k")
			expect(loaded:get_truth().money).to.equal(5)
			loaded:unload()
		end)

		it("is a session with a readable name", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k")
			expect(miumiu.is_session(loaded)).to.equal(true)
			expect(miumiu.is_session({})).to.equal(false)
			expect(tostring(loaded)).to.equal("Session(k)")
			loaded:unload()
		end)
	end)

	describe("session.journal", function()
		it("applies journaled ops to the truth before they are written", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(loaded, { set("money", 9, 1) })
			expect(loaded:get_truth().money).to.equal(9)
			expect(loaded:is_dirty()).to.equal(true)
			expect(backend:dump("k")).to.equal(nil)
			loaded:unload()
		end)

		it("writes journaled ops with stamps and a version", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(loaded, { set("money", 9, 1), add("gems", 2) })
			loaded:sync()
			local record = backend:dump("k")
			expect(record.data.money).to.equal(9)
			expect(record.data.gems).to.equal(2)
			expect(record.stamps.money).to.equal(1)
			expect(loaded:get_stamps().money).to.equal(1)
			expect(record.version).to.equal(1)
			expect(loaded:is_dirty()).to.equal(false)
			loaded:unload()
		end)

		it("lets a writer's own later op on a key win a same-second tie", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local now = os.time()
			utils.journal(loaded, { set("money", 1, now), set("money", 2, now) })
			expect(loaded:get_truth().money).to.equal(2)
			loaded:sync()
			utils.journal(loaded, { utils.remove("money", now) })
			loaded:sync()
			local record = backend:dump("k")
			expect(record.data.money).to.equal(nil)
			expect(record.stamps.money).to.equal(now + 2)
			loaded:unload()
		end)

		it("ignores an empty journal", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(loaded, {})
			expect(loaded:is_dirty()).to.equal(false)
			loaded:unload()
		end)

		it("fires pulled with the merged truth", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local seen = nil
			loaded:hook(hooks.pulled, function(truth)
				seen = truth
			end)
			utils.journal(loaded, { set("money", 4, 1) })
			loaded:sync()
			expect(seen.money).to.equal(4)
			loaded:unload()
		end)

		it("keeps unwritten ops when the write fails", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never, retry_attempts = 1 })
			utils.journal(loaded, { set("money", 4, 1) })
			backend:fail_next("UpdateAsync", "before", "flaky")
			expect(function()
				loaded:sync()
			end).to.throw("flaky")
			expect(loaded:is_dirty()).to.equal(true)
			expect(loaded:get_truth().money).to.equal(4)
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(4)
			loaded:unload()
		end)

		it("keeps an op journaled while a pull is in flight", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(loaded, { set("money", 1, 1) })
			backend:delay_next("UpdateAsync", utils.timings.in_flight)
			local done = false
			task.spawn(function()
				loaded:sync()
				done = true
			end)
			expect(utils.wait_until(function()
				return backend.calls.UpdateAsync == 1
			end)).to.equal(true)
			utils.journal(loaded, { add("gems", 3) })
			expect(utils.wait_until(function()
				return done
			end)).to.equal(true)
			expect(backend:dump("k").data.money).to.equal(1)
			expect(backend:dump("k").data.gems).to.equal(nil)
			expect(loaded:is_dirty()).to.equal(true)
			expect(loaded:get_truth().gems).to.equal(3)
			loaded:sync()
			expect(backend:dump("k").data.gems).to.equal(3)
			loaded:unload()
		end)

		it("keeps references of untouched keys across pulls", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(loaded, { set("items", { "a" }, 1) })
			loaded:sync()
			local items = loaded:get_truth().items
			utils.journal(loaded, { add("money", 1) })
			loaded:sync()
			expect(loaded:get_truth().items).to.equal(items)
			loaded:unload()
		end)
	end)

	describe("two servers", function()
		it("converge on deltas from both", function()
			local backend = utils.create_backend()
			local a = utils.open_session(backend, "k", { pull_interval = never })
			local b = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(a, { add("money", 5) })
			utils.journal(b, { add("money", 3) })
			a:sync()
			b:sync()
			a:sync()
			expect(a:get_truth().money).to.equal(8)
			expect(b:get_truth().money).to.equal(8)
			expect(backend:dump("k").version).to.equal(2)
			a:unload()
			b:unload()
		end)

		it("drop a stale set from the server the player left", function()
			local backend = utils.create_backend()
			local old_server = utils.open_session(backend, "k", { pull_interval = never })
			local new_server = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(old_server, { set("inventory", { "sword" }, 100) })
			utils.journal(new_server, { set("inventory", {}, 200) })
			new_server:sync()
			old_server:unload()
			local record = backend:dump("k")
			expect(#record.data.inventory).to.equal(0)
			expect(record.stamps.inventory).to.equal(200)
			new_server:unload()
		end)
	end)

	describe("shared groups", function()
		it("land in pending, not in data, and show in the truth", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local id = fresh_id()
			utils.journal(loaded, { set("money", 5, 1) }, id, true)
			loaded:sync()
			local record = backend:dump("k")
			expect(record.data.money).to.equal(nil)
			expect(record.pending[id].ops[1].value).to.equal(5)
			expect(record.pending[id].created > 0).to.equal(true)
			expect(loaded:get_truth().money).to.equal(5)
			expect(loaded:is_dirty()).to.equal(false)
			loaded:unload()
		end)

		it("fold into data once committed", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local id = fresh_id()
			utils.journal(loaded, { set("money", 5, 1) }, id, true)
			loaded:sync()
			commit.mark(loaded:get_config(), id)
			loaded:sync()
			local record = backend:dump("k")
			expect(record.data.money).to.equal(5)
			expect(record.pending).to.equal(nil)
			expect(loaded:get_truth().money).to.equal(5)
			expect(loaded:get_truth().money).to.equal(backend:dump("k").data.money)
			loaded:unload()
		end)

		it("vanish from the truth once failed", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local id = fresh_id()
			utils.journal(loaded, { set("money", 5, 1) }, id, true)
			loaded:sync()
			expect(loaded:get_truth().money).to.equal(5)
			local started = os.time()
			expect(utils.wait_until(function()
				return os.time() - started > utils.timings.commit_timeout
			end, utils.timings.long)).to.equal(true)
			loaded:sync()
			expect(loaded:get_truth().money).to.equal(nil)
			expect(backend:dump("k").pending).to.equal(nil)
			expect(loaded:get_truth().money).to.equal(backend:dump("k").data.money)
			loaded:unload()
		end)

		it("resolve another server's committed entry on load", function()
			local backend = utils.create_backend()
			local config = utils.create_config(backend)
			local id = fresh_id()
			backend:seed("k", {
				data = { money = 1 },
				pending = { [id] = { created = os.time(), ops = { add("money", 4) } } },
			})
			backend.service:GetDataStore(config.commit_store):SetAsync(id, true)
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			expect(loaded:get_truth().money).to.equal(5)
			expect(backend:dump("k").data.money).to.equal(5)
			expect(backend:dump("k").pending).to.equal(nil)
			loaded:unload()
		end)

		it("keep another server's undecided entry", function()
			local backend = utils.create_backend()
			local id = fresh_id()
			backend:seed("k", {
				data = { money = 1 },
				pending = { [id] = { created = os.time(), ops = { add("money", 4) } } },
			})
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			expect(loaded:get_truth().money).to.equal(1)
			expect(backend:dump("k").pending[id]).to.be.ok()
			loaded:unload()
		end)

		it("drop another server's entry once it times out", function()
			local backend = utils.create_backend()
			local id = fresh_id()
			backend:seed("k", {
				data = { money = 1 },
				pending = {
					[id] = {
						created = os.time() - utils.timings.commit_timeout - 1,
						ops = { add("money", 4) },
					},
				},
			})
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			expect(loaded:get_truth().money).to.equal(1)
			expect(backend:dump("k").pending).to.equal(nil)
			loaded:unload()
		end)
	end)

	describe("pull loop", function()
		it("pulls on its own", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k")
			utils.journal(loaded, { set("money", 7, 1) })
			expect(utils.wait_until(function()
				local record = backend:dump("k")
				return record ~= nil and record.data.money == 7
			end)).to.equal(true)
			loaded:unload()
		end)

		it("stops after unload", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k")
			expect(utils.wait_until(function()
				return backend.calls.GetAsync >= 2
			end)).to.equal(true)
			loaded:unload()
			local reads = backend.calls.GetAsync
			task.wait(utils.timings.grace)
			expect(backend.calls.GetAsync).to.equal(reads)
		end)
	end)

	describe("session.unload", function()
		it("writes what is left and closes", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local closed = 0
			loaded:hook(hooks.closed, function()
				closed += 1
			end)
			utils.journal(loaded, { set("money", 8, 1) })
			loaded:unload()
			expect(backend:dump("k").data.money).to.equal(8)
			expect(loaded:is_open()).to.equal(false)
			expect(closed).to.equal(1)
		end)

		it("rejects calls once closed", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k")
			loaded:unload()
			expect(function()
				loaded:sync()
			end).to.throw("closed")
			expect(function()
				utils.journal(loaded, { add("money", 1) })
			end).to.throw("closed")
			expect(function()
				loaded:unload()
			end).to.throw("closed")
			local disconnect = loaded:hook(hooks.closed, function() end)
			disconnect()
		end)
	end)

	describe("idle pulls", function()
		it("read instead of writing while nothing is journaled", function()
			local backend = utils.create_backend()
			backend:seed("k", { data = { money = 5 } })
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			loaded:sync()
			loaded:sync()
			expect(backend.calls.UpdateAsync).to.equal(nil)
			expect(backend.calls.GetAsync).to.equal(3)
			utils.journal(loaded, { add("money", 1) })
			loaded:sync()
			expect(backend.calls.UpdateAsync).to.equal(1)
			expect(backend:dump("k").data.money).to.equal(6)
			loaded:unload()
		end)

		it("adopt a remote change and fire pulled", function()
			local backend = utils.create_backend()
			local a = utils.open_session(backend, "k", { pull_interval = never })
			local b = utils.open_session(backend, "k", { pull_interval = never })
			local seen = nil
			a:hook(hooks.pulled, function(truth)
				seen = truth
			end)
			utils.journal(b, { set("money", 7, 1) })
			b:sync()
			local writes = backend.calls.UpdateAsync
			a:sync()
			expect(backend.calls.UpdateAsync).to.equal(writes)
			expect(seen.money).to.equal(7)
			a:unload()
			b:unload()
		end)

		it("write when the read shows pending entries to settle", function()
			local backend = utils.create_backend()
			local config = utils.create_config(backend)
			local id = fresh_id("commit")
			backend:seed("k", {
				data = {},
				pending = { [id] = { created = os.time() - config.commit_timeout - 1, ops = { add("money", 1) } } },
			})
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			expect(backend.calls.UpdateAsync).to.equal(1)
			expect(backend:dump("k").pending).to.equal(nil)
			expect(loaded:get_truth().money).to.equal(nil)
			loaded:unload()
		end)

		it("write when the read shows a newer migration count", function()
			local backend = utils.create_backend()
			backend:seed("k", { data = { money = 1 }, migrations = 0 })
			local loaded = utils.open_session(backend, "k", { pull_interval = never, migrations = { function() end } })
			expect(backend.calls.UpdateAsync).to.equal(1)
			expect(backend:dump("k").migrations).to.equal(1)
			loaded:unload()
		end)
	end)

	describe("session.watch", function()
		it("reports a watched group landed after the write, outside the lock", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local outcomes = {}
			local id = fresh_id()
			utils.journal(loaded, { set("money", 1, 1) }, id)
			loaded:watch(id, function(outcome)
				table.insert(outcomes, outcome.kind)
				loaded:sync()
			end)
			loaded:sync()
			expect(#outcomes).to.equal(1)
			expect(outcomes[1]).to.equal("landed")
			expect(backend:dump("k").data.money).to.equal(1)
			loaded:unload()
		end)

		it("refuses watched groups when a newer server takes the key and on wipe, never on a clean close", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local outcomes = {}
			local function watched(id: string)
				loaded:watch(id, function(outcome)
					table.insert(outcomes, if outcome.kind == "landed" then "landed" else outcome.message)
				end)
			end
			local wiped = fresh_id()
			utils.journal(loaded, { set("money", 1, 1) }, wiped)
			watched(wiped)
			loaded:wipe()
			expect(#outcomes).to.equal(1)
			expect((string.find(outcomes[1], "wiped", 1, true))).to.be.ok()
			local dropped = fresh_id()
			utils.journal(loaded, { set("money", 2, 2) }, dropped)
			watched(dropped)
			loaded:drop_group(dropped)
			local refused = fresh_id()
			utils.journal(loaded, { set("money", 3, 3) }, refused)
			watched(refused)
			utils.open_session(backend, "k", { pull_interval = never, migrations = { function() end } }):unload()
			expect(function()
				loaded:sync()
			end).to.throw("newer server")
			expect(#outcomes).to.equal(2)
			expect((string.find(outcomes[2], "newer server", 1, true))).to.be.ok()
			local clean = utils.open_session(backend, "j", { pull_interval = never })
			local carried = fresh_id()
			utils.journal(clean, { set("money", 4, 4) }, carried)
			clean:watch(carried, function(outcome)
				table.insert(outcomes, outcome.kind)
			end)
			clean:unload()
			expect(#outcomes).to.equal(3)
			expect(outcomes[3]).to.equal("landed")
			expect(backend:dump("j").data.money).to.equal(4)
		end)
	end)

	describe("regressions", function()
		local function put_money(loaded, money: number, at: number)
			loaded:journal({
				id = utils.fresh_id(),
				ops = { set("money", money, at) },
				kind = "single",
				coalesce = "money",
			})
		end

		it("keeps a coalesced write journaled during the pull that lands its predecessor", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local at = os.time()
			backend:delay_next("GetAsync", utils.timings.in_flight, "before")
			backend:delay_next("UpdateAsync", utils.timings.in_flight, "after")
			local reads = backend.calls.GetAsync
			local done = false
			task.spawn(function()
				loaded:sync()
				done = true
			end)
			expect(utils.wait_until(function()
				return backend.calls.GetAsync > reads
			end)).to.equal(true)
			put_money(loaded, 5, at)
			expect(utils.wait_until(function()
				return backend.calls.UpdateAsync == 1
			end)).to.equal(true)
			put_money(loaded, 6, at)
			expect(utils.wait_until(function()
				return done
			end)).to.equal(true)
			expect(loaded:get_truth().money).to.equal(6)
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(6)
		end)

		it("keeps a coalesced write journaled while its predecessor is in flight", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local at = os.time()
			put_money(loaded, 5, at)
			backend:delay_next("UpdateAsync", utils.timings.in_flight, "after")
			local done = false
			task.spawn(function()
				loaded:sync()
				done = true
			end)
			expect(utils.wait_until(function()
				return backend.calls.UpdateAsync == 1
			end)).to.equal(true)
			put_money(loaded, 6, at)
			expect(utils.wait_until(function()
				return done
			end)).to.equal(true)
			expect(loaded:get_truth().money).to.equal(6)
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(6)
		end)

		it("coalesces after its cached state was forgotten", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local function put(money: number)
				loaded:journal({
					id = utils.fresh_id(),
					ops = { { kind = "put", key = "inventory", path = { "x" }, value = { money = money }, at = 1 } },
					kind = "single",
					coalesce = "inventory/x",
				})
			end
			put(1)
			loaded:drop_group("nothing")
			put(2)
			expect(loaded:get_truth().inventory.x.money).to.equal(2)
			loaded:sync()
			expect(backend:dump("k").data.inventory.x.money).to.equal(2)
		end)

		it("bumps a put behind the stamps it knows and prunes stale stamps of dropped paths", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local old = os.time() - 5
			utils.journal(
				loaded,
				{ { kind = "put", key = "inventory", path = { "x" }, value = { money = 1 }, at = old } }
			)
			loaded:sync()
			expect(backend:dump("k").stamps["inventory/x"]).to.equal(old)
			utils.journal(
				loaded,
				{ { kind = "put", key = "inventory", path = { "x" }, value = { money = 2 }, at = old } }
			)
			loaded:sync()
			local record = backend:dump("k")
			expect(record.data.inventory.x.money).to.equal(2)
			expect(record.stamps["inventory/x"]).to.equal(old + 1)
			utils.journal(loaded, { { kind = "drop", key = "inventory", path = { "x" }, at = old + 2 } })
			loaded:sync()
			record = backend:dump("k")
			expect(record.data.inventory.x).to.equal(nil)
			expect(record.stamps["inventory/x"]).to.equal(nil)
		end)

		it("does not warn when an unload waits behind a pull that closes the session", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = utils.timings.short })
			backend:delay_next("GetAsync", utils.timings.in_flight, "before")
			expect(utils.wait_until(function()
				return backend.calls.GetAsync == 2
			end)).to.equal(true)
			loaded:unload()
			expect(loaded:is_open()).to.equal(false)
			expect(#backend.warnings).to.equal(0)
		end)

		it("closes on a newer record found by the commit-status rerun", function()
			local backend = utils.create_backend()
			local config = utils.create_config(backend)
			local id = fresh_id("commit")
			backend:seed("k", {
				data = {},
				pending = { [id] = { created = os.time(), ops = { add("money", 1) } } },
			})
			utils.commit_store(backend, config):SetAsync(id, true)
			backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			local err = nil
			task.spawn(function()
				local ok, result = pcall(utils.open_session, backend, "k", { pull_interval = never })
				err = if ok then "opened" else result
			end)
			expect(utils.wait_until(function()
				return backend.calls.UpdateAsync == 1
			end)).to.equal(true)
			backend:seed("k", { data = { money = 1 }, migrations = 3 })
			expect(utils.wait_until(function()
				return err ~= nil
			end)).to.equal(true)
			expect((string.find(err, "newer server", 1, true))).to.be.ok()
		end)

		it("adopts a deleted record as an empty one", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(loaded, { set("money", 3, 1) })
			utils.journal(loaded, { add("gems", 2) }, fresh_id("shared"), true)
			loaded:sync()
			expect(loaded:get_truth().gems).to.equal(2)
			local seen = nil
			loaded:hook(hooks.pulled, function(truth)
				seen = truth
			end)
			backend.store:RemoveAsync("k")
			loaded:sync()
			expect(seen).to.be.ok()
			expect(loaded:get_truth().money).to.equal(nil)
			expect(loaded:get_truth().gems).to.equal(nil)
			utils.journal(loaded, { add("money", 2) })
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(2)
			expect(backend:dump("k").version).to.equal(1)
			loaded:unload()
		end)

		it("does not fire pulled once the session has closed", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local fired = 0
			loaded:hook(hooks.pulled, function()
				fired += 1
			end)
			utils.journal(loaded, { add("money", 1) })
			loaded:unload()
			expect(loaded:is_open()).to.equal(false)
			expect(fired).to.equal(0)
			expect(backend:dump("k").data.money).to.equal(1)
		end)

		it("reads on the idle interval and writes on the pull interval", function()
			local backend = utils.create_backend()
			local pull, idle = utils.timings.short, utils.timings.slow
			local loaded = utils.open_session(backend, "k", { pull_interval = pull, idle_interval = idle })
			expect(utils.wait_until(function()
				return loaded:get_pulls() >= 1
			end, idle * 2)).to.equal(true)
			local reads = backend.calls.GetAsync
			expect(reads).to.equal(2)
			utils.journal(loaded, { add("money", 1) })
			expect(utils.wait_until(function()
				return backend.calls.UpdateAsync == 1
			end, pull * 10)).to.equal(true)
			expect(backend.calls.GetAsync).to.equal(reads)
			loaded:sync()
			expect(backend.calls.GetAsync).to.equal(reads + 1)
			task.wait(utils.timings.grace)
			expect(backend.calls.GetAsync).to.equal(reads + 1)
			expect(utils.wait_until(function()
				return backend.calls.GetAsync >= reads + 2
			end, idle * 2)).to.equal(true)
			loaded:unload()
		end)

		it("adopts a record recreated with the same version count", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(loaded, { set("money", 3, 1) })
			loaded:sync()
			backend.store:RemoveAsync("k")
			local other = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(other, { set("money", 9, 2) })
			other:sync()
			expect(backend:dump("k").version).to.equal(1)
			utils.journal(loaded, { add("gems", 1) })
			loaded:sync()
			expect(loaded:get_truth().money).to.equal(9)
			expect(backend:dump("k").data.money).to.equal(9)
			expect(backend:dump("k").data.gems).to.equal(1)
			loaded:unload()
			other:unload()
		end)

		it("forgets landed ids older than commit_timeout on the next write", function()
			local backend = utils.create_backend()
			local loaded =
				utils.open_session(backend, "k", { pull_interval = never, commit_timeout = utils.timings.window })
			local first = fresh_id("landed")
			utils.journal(loaded, { add("money", 1) }, first)
			loaded:sync()
			expect(backend:dump("k").landed[first]).to.be.ok()
			local started = os.time()
			expect(utils.wait_until(function()
				return os.time() > started
			end, utils.timings.long)).to.equal(true)
			utils.journal(loaded, { add("money", 1) })
			loaded:sync()
			expect(backend:dump("k").landed[first]).to.equal(nil)
			loaded:unload()
		end)

		it("closes a clean session on unload without a request", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local reads = backend.calls.GetAsync
			loaded:unload()
			expect(loaded:is_open()).to.equal(false)
			expect(backend.calls.GetAsync).to.equal(reads)
			expect(backend.calls.UpdateAsync).to.equal(nil)
		end)

		it("fires pulled outside the lock so a callback may pull again", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local nested = 0
			loaded:hook(hooks.pulled, function()
				if nested == 0 then
					nested += 1
					loaded:sync()
				end
			end)
			utils.journal(loaded, { add("money", 1) })
			loaded:sync()
			expect(nested).to.equal(1)
			expect(backend:dump("k").data.money).to.equal(1)
			loaded:unload()
		end)

		it("warns once while pulls keep failing and once when they recover", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = utils.timings.fast, retry_attempts = 1 })
			backend:fail_next("GetAsync", "before", "flaky")
			backend:fail_next("GetAsync", "before", "flaky")
			expect(utils.wait_until(function()
				return #backend.failures == 0 and backend.calls.GetAsync >= 4
			end)).to.equal(true)
			expect(utils.wait_until(function()
				return #backend.warnings == 2
			end)).to.equal(true)
			expect((string.find(backend.warnings[1], "flaky", 1, true))).to.be.ok()
			expect((string.find(backend.warnings[2], "succeeded again", 1, true))).to.be.ok()
			utils.journal(loaded, { set("money", 1, 1) })
			expect(utils.wait_until(function()
				local record = backend:dump("k")
				return record ~= nil and record.data.money == 1
			end)).to.equal(true)
			loaded:unload()
		end)

		it("probes for a landed group without the read cache", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local before = backend.fresh_reads
			expect(loaded:resolve_group("nothing", "x").kind).to.equal("refused")
			expect(backend.fresh_reads).to.equal(before + 1)
			loaded:unload()
		end)

		it("does not await a shared group abandoned while its write is in flight", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local id = fresh_id("shared")
			utils.journal(loaded, { add("money", 1) }, id, true)
			backend:delay_next("UpdateAsync", utils.timings.in_flight)
			local done = false
			task.spawn(function()
				loaded:sync()
				done = true
			end)
			expect(utils.wait_until(function()
				return backend.calls.UpdateAsync == 1
			end)).to.equal(true)
			loaded:drop_group(id)
			expect(utils.wait_until(function()
				return done
			end)).to.equal(true)
			expect(backend:dump("k").pending[id]).to.be.ok()
			expect(loaded:get_truth().money).to.equal(nil)
			expect(loaded:is_dirty()).to.equal(false)
			loaded:unload()
		end)

		it("closes and throws when a pull finds a newer record", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			local closed = false
			loaded:hook(hooks.closed, function()
				closed = true
			end)
			backend:seed("k", { data = { money = 1 }, migrations = 3 })
			expect(function()
				loaded:sync()
			end).to.throw("newer server")
			expect(loaded:is_open()).to.equal(false)
			expect(closed).to.equal(true)
			local status = loaded:get_status()
			assert(status.kind == "closed")
			local closure = status.closure
			assert(closure.kind == "refused")
			expect((string.find(closure.message, "newer server", 1, true))).to.be.ok()
		end)

		it("does not warn when the pull loop stops on a newer record", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = utils.timings.fast })
			backend:seed("k", { data = { money = 1 }, migrations = 3 })
			expect(utils.wait_closed(loaded)).to.equal(true)
			task.wait(utils.timings.grace)
			expect(#backend.warnings).to.equal(0)
		end)

		it("does not double-apply deltas when a write fails after landing", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(loaded, { add("money", 1) })
			backend:fail_next("UpdateAsync", "after", "late")
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(1)
			expect(loaded:get_truth().money).to.equal(1)
			expect(backend:dump("k").landed).to.be.ok()
			loaded:unload()
		end)

		it("forgets an awaiting group another server folded first", function()
			local backend = utils.create_backend()
			local a = utils.open_session(backend, "k", { pull_interval = never })
			local b = utils.open_session(backend, "k", { pull_interval = never })
			local id = fresh_id("fold")
			utils.journal(a, { add("money", 4) }, id, true)
			a:sync()
			commit.mark(a:get_config(), id)
			b:sync()
			expect(backend:dump("k").data.money).to.equal(4)
			expect(backend:dump("k").pending).to.equal(nil)
			a:sync()
			expect(a:get_truth().money).to.equal(4)
			a:sync()
			expect(a:get_truth().money).to.equal(4)
			a:unload()
			b:unload()
		end)

		it("keeps ops and retries when the final write fails", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = utils.timings.short, retry_attempts = 1 })
			utils.journal(loaded, { set("money", 3, 1) })
			backend:fail_next("UpdateAsync", "before", "down")
			expect(function()
				loaded:unload()
			end).to.throw("down")
			expect(loaded:is_open()).to.equal(true)
			expect(loaded:is_dirty()).to.equal(true)
			expect(utils.wait_closed(loaded)).to.equal(true)
			expect(backend:dump("k").data.money).to.equal(3)
		end)

		it("adopts a record that has no version", function()
			local backend = utils.create_backend()
			backend.store:SetAsync("k", { data = { money = 8 } })
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			expect(loaded:get_truth().money).to.equal(8)
			utils.journal(loaded, { add("money", 1) })
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(9)
			loaded:unload()
		end)

		it("warns when a hook callback throws", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			loaded:hook(hooks.pulled, function()
				error("hook boom")
			end)
			utils.journal(loaded, { set("money", 1, 1) })
			loaded:sync()
			expect((string.find(backend.warnings[#backend.warnings], "hook boom", 1, true))).to.be.ok()
			expect(backend:dump("k").data.money).to.equal(1)
			loaded:unload()
		end)

		it("tolerates delta ops on a key of another shape", function()
			local backend = utils.create_backend()
			backend:seed("k", { data = { money = "text", items = 5 } })
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(loaded, { add("money", 2), { kind = "insert", key = "items", value = "a" } })
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(2)
			expect(backend:dump("k").data.items[1]).to.equal("a")
			loaded:unload()
		end)

		it("closes a leave with only an undecided shared group without a request", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never, commit_timeout = never })
			utils.journal(loaded, { utils.add("money", 1) }, utils.fresh_id(), true)
			loaded:sync()
			local reads = backend.calls.GetAsync
			loaded:unload()
			expect(loaded:is_open()).to.equal(false)
			expect(backend.calls.GetAsync).to.equal(reads)
		end)

		it("carries record fields it does not know through writes and wipes", function()
			local backend = utils.create_backend()
			backend:seed("k", { data = { money = 1 }, extra = "keep" })
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(loaded, { set("money", 2, 2) })
			loaded:sync()
			expect(backend:dump("k").extra).to.equal("keep")
			expect(backend:dump("k").format).to.equal(1)
			loaded:wipe()
			expect(backend:dump("k").extra).to.equal("keep")
			expect(backend:dump("k").data.money).to.equal(nil)
		end)

		it("never pulls on its own with pull_interval = math.huge", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = math.huge })
			utils.journal(loaded, { set("money", 2, 2) })
			expect(utils.wait_until(function()
				return backend:dump("k") ~= nil
			end, utils.timings.grace)).to.equal(false)
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(2)
		end)

		it("retries the landed probe through a transient read failure", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(
				backend,
				"k",
				{ pull_interval = never, retry_attempts = 2, retry_base = utils.timings.fast }
			)
			local id = utils.fresh_id()
			backend:seed("k", { data = { money = 1 }, landed = { [id] = os.time() } })
			backend:fail_next("GetAsync", "before", "read blip")
			expect(loaded:resolve_group(id, "gone").kind).to.equal("landed")
			loaded:unload()
		end)

		it("rejects a hook symbol a session never fires", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k", { pull_interval = never })
			expect(function()
				loaded:hook(miumiu.hooks.landed, function() end)
			end).to.throw("hooks.pulled, hooks.closed or hooks.writing")
			loaded:unload()
		end)

		it("an init does not resurrect a key a newer remove stamped", function()
			local backend = utils.create_backend()
			local x = utils.open_session(backend, "k", { pull_interval = never })
			local y = utils.open_session(backend, "k", { pull_interval = never })
			utils.journal(x, { utils.remove("money", os.time()) })
			x:sync()
			utils.journal(y, { { kind = "init", key = "money", value = 100 }, utils.add("money", 10) })
			y:sync()
			expect(backend:dump("k").data.money).to.equal(10)
			x:unload()
			y:unload()
		end)

		it("forgets a record stored with version 0 once the store no longer holds it", function()
			local backend = utils.create_backend()
			backend:seed_raw("k", { data = { money = 5 }, stamps = { money = 1 }, version = 0, migrations = 0 })
			local loaded = utils.open_session(backend, "k")
			expect(loaded:get_truth().money).to.equal(5)
			backend.store:RemoveAsync("k")
			loaded:sync()
			expect(loaded:get_truth().money).to.equal(nil)
			expect(backend:dump("k")).to.equal(nil)
			loaded:unload()
		end)

		it("reads a record whose stored fields are not the types it writes as an empty one", function()
			local backend = utils.create_backend()
			backend:seed_raw("k", { data = 5, stamps = 7, version = "one", migrations = "none", format = "old" })
			local loaded = utils.open_session(backend, "k")
			expect((next(loaded:get_truth()))).to.equal(nil)
			utils.journal(loaded, { set("money", 3, os.time()) })
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(3)
			loaded:unload()
		end)

		it("keeps only the stamps stored as a string key and a number", function()
			local backend = utils.create_backend()
			backend:seed_raw("k", {
				data = { money = 5 },
				stamps = { money = 2, items = "soon" },
				version = 1,
				migrations = 0,
			})
			local loaded = utils.open_session(backend, "k")
			utils.journal(loaded, { set("items", { "a" }, os.time()) })
			loaded:sync()
			local record = backend:dump("k")
			expect(record.data.money).to.equal(5)
			expect(record.data.items[1]).to.equal("a")
			expect(record.stamps.items > 0).to.equal(true)
			loaded:unload()
		end)

		it("reads a record whose pending and landed are not tables as an empty one", function()
			local backend = utils.create_backend()
			backend:seed_raw("k", {
				data = { money = 5 },
				stamps = { money = 1 },
				version = 1,
				migrations = 0,
				pending = 5,
				landed = "gone",
			})
			local loaded = utils.open_session(backend, "k")
			expect(loaded:get_truth().money).to.equal(5)
			utils.journal(loaded, { set("money", 9, os.time()) })
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(9)
			loaded:unload()
		end)

		it("writes over a key whose stored value is not a record at all", function()
			local backend = utils.create_backend()
			backend:seed_raw("k", "just a string")
			local loaded = utils.open_session(backend, "k")
			utils.journal(loaded, { set("money", 9, os.time()) })
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(9)
			loaded:unload()
		end)

		it("reads a record whose pending is not a table while a shared group is awaiting", function()
			local backend = utils.create_backend()
			local loaded = utils.open_session(backend, "k")
			utils.journal(loaded, { set("money", 3, os.time()) }, fresh_id(), true)
			loaded:sync()
			local record = backend:dump("k")
			record.pending = 5
			backend:seed_raw("k", record)
			loaded:sync()
			utils.journal(loaded, { set("money", 7, os.time()) })
			loaded:sync()
			expect(backend:dump("k").data.money).to.equal(7)
			loaded:unload()
		end)
	end)
end
