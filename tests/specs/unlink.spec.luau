return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local jecs = require(ReplicatedStorage.Packages.jecs)
	local miumiu = require(ReplicatedStorage.Packages.miumiu)
	local state = require(ReplicatedStorage.Packages.miumiu.state)
	local utils = require(ReplicatedStorage.Tests.utils)

	afterEach(utils.cleanup)

	local never = utils.timings.never

	local setup = utils.create_fixture
	local settle = utils.settle

	local link_state = utils.link_state

	describe("unlink", function()
		it("writes what is left, clears marks and closes the session", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 8)
			local loaded = utils.session_of(t, "p1")
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(t.world:has(player, t.loaded)).to.equal(false)
			expect(utils.wait_closed(loaded)).to.equal(true)
			expect(t.backend:dump("p1").data.money).to.equal(8)
			expect(link_state(t, "p1")).to.equal(nil)
		end)

		it("a clean unlink closes without touching storage", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local session = miumiu.get_session(t.world, t.player_data, "p1")
			assert(session)
			expect(session:get_status().kind).to.equal("open")
			local reason = nil
			session:hook(miumiu.hooks.closed, function(closure)
				reason = closure
			end)
			local reads, writes = t.backend.calls.GetAsync, t.backend.calls.UpdateAsync
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(session:is_open()).to.equal(false)
			assert(reason)
			expect(reason.kind).to.equal("clean")
			expect(t.backend.calls.GetAsync).to.equal(reads)
			expect(t.backend.calls.UpdateAsync).to.equal(writes)
			expect(link_state(t, "p1")).to.equal(nil)
		end)

		it("writes pending lazy values on unlink", function()
			local t = setup({ pull_interval = never })
			local battery = utils.declare_saveable(t.world, "component", "battery", { t.player_data })
			t.world:add(battery, miumiu.lazy)
			local player = utils.link_entity(t, "p1")
			local loaded = utils.session_of(t, "p1")
			t.world:set(player, battery, 42)
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(utils.wait_closed(loaded)).to.equal(true)
			expect(t.backend:dump("p1").data.battery).to.equal(42)
		end)

		it("drops the pending lazy marks of a deleted entity", function()
			local t = setup({ pull_interval = never })
			local battery = utils.declare_saveable(t.world, "component", "battery", { t.player_data })
			t.world:add(battery, miumiu.lazy)
			local player = utils.link_entity(t, "p1")
			local loaded = utils.session_of(t, "p1")
			t.world:set(player, battery, 42)
			loaded:sync()
			t.world:set(player, battery, 43)
			t.world:delete(player)
			miumiu.step(t.world)
			expect(utils.wait_closed(loaded)).to.equal(true)
			expect(t.backend:dump("p1").data.battery).to.equal(42)
		end)

		it("unloads the session even when a removed listener throws during unlink", function()
			local t = setup({ pull_interval = never })
			local kinds = utils.declare_kinds(t.world, t.player_data)
			local owns, item = kinds.owns, kinds.item
			local player = utils.link_entity(t, "p1")
			local sword = t.world:entity()
			t.world:add(sword, item)
			t.world:add(sword, jecs.pair(owns, player))
			local session = utils.session_of(t, "p1")
			session:sync()
			local disconnect = t.world:removed(item, function()
				error("listener boom")
			end)
			t.world:remove(player, t.link)
			expect(function()
				miumiu.step(t.world)
			end).to.throw("listener boom")
			disconnect()
			expect(utils.wait_closed(session)).to.equal(true)
			miumiu.step(t.world)
			expect(link_state(t, "p1")).to.equal(nil)
			expect(miumiu.get_session(t.world, t.player_data, "p1")).to.equal(nil)
		end)

		it("unloads the session and writes when a removed data_loaded listener throws", function()
			local t = setup({ pull_interval = never })
			local player = utils.link_entity(t, "p1", { money = 1 })
			local session = utils.session_of(t, "p1")
			local disconnect = t.world:removed(miumiu.data_loaded, function()
				error("loaded gone boom")
			end)
			t.world:set(player, t.money, 2)
			t.world:remove(player, t.link)
			expect(function()
				miumiu.step(t.world)
			end).to.throw("loaded gone boom")
			disconnect()
			expect(utils.wait_closed(session)).to.equal(true)
			miumiu.step(t.world)
			expect(link_state(t, "p1")).to.equal(nil)
			expect(state.get(t.world).links[player]).to.equal(nil)
			expect(t.backend:dump("p1").data.money).to.equal(2)
		end)

		it("close unloads every session when a removed data_loaded listener throws", function()
			local t = setup({ pull_interval = never })
			local a = utils.link_entity(t, "a", { money = 1 })
			local b = utils.link_entity(t, "b", { money = 1 })
			local sa = utils.session_of(t, "a")
			local sb = utils.session_of(t, "b")
			t.world:set(a, t.money, 2)
			t.world:set(b, t.money, 2)
			local disconnect = t.world:removed(miumiu.data_loaded, function()
				error("close boom")
			end)
			expect(function()
				miumiu.close(t.world, utils.timings.budget)
			end).to.throw("close boom")
			disconnect()
			expect(sa:is_open()).to.equal(false)
			expect(sb:is_open()).to.equal(false)
			expect(t.backend:dump("a").data.money).to.equal(2)
			expect(t.backend:dump("b").data.money).to.equal(2)
		end)

		it("keeps the session while another entity still links the key", function()
			local t = setup()
			local a = t.world:entity()
			local b = t.world:entity()
			t.world:set(a, t.link, "p1")
			t.world:set(b, t.link, "p1")
			settle(t, a)
			settle(t, b)
			local loaded = utils.session_of(t, "p1")
			t.world:remove(a, t.link)
			miumiu.step(t.world)
			task.wait(utils.timings.grace)
			expect(loaded:is_open()).to.equal(true)
			expect(t.world:has(b, t.loaded)).to.equal(true)
		end)

		it("before the load finishes cancels the load", function()
			local t = setup({ pull_interval = never })
			t.backend:delay_next("GetAsync", utils.timings.in_flight, "before")
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			miumiu.step(t.world)
			local loading_link = link_state(t, "p1")
			assert(loading_link)
			local phase = loading_link.phase
			assert(phase.kind == "loading")
			local loading = phase.thread
			expect(coroutine.status(loading)).to.equal("suspended")
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(t.world:has(player, t.loading)).to.equal(false)
			expect(coroutine.status(loading)).to.equal("dead")
			task.wait(utils.timings.grace)
			miumiu.step(t.world)
			expect(t.world:has(player, t.loaded)).to.equal(false)
			expect(t.backend:dump("p1")).to.equal(nil)
			expect(link_state(t, "p1")).to.equal(nil)
			expect(#utils.events(t)).to.equal(0)
		end)

		it("close writes everything, stops listening and makes step a no-op", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 6)
			local loaded = utils.session_of(t, "p1")

			miumiu.close(t.world)
			expect(loaded:is_open()).to.equal(false)
			expect(t.backend:dump("p1").data.money).to.equal(6)
			expect(t.world:has(player, t.loaded)).to.equal(false)
			expect(link_state(t, "p1")).to.equal(nil)
			expect(#state.get(t.world).disconnects).to.equal(0)

			local calls = t.backend.calls.UpdateAsync
			t.world:set(player, t.money, 7)
			local other = t.world:entity()
			t.world:set(other, t.link, "p2")
			expect(settle(t, other)).to.equal(false)
			expect(#utils.events(t)).to.equal(0)
			expect(t.world:has(other, t.loading)).to.equal(false)
			expect(t.backend.calls.UpdateAsync).to.equal(calls)
			expect(t.backend:dump("p1").data.money).to.equal(6)
			miumiu.close(t.world)
		end)

		it("in the same frame as the link never loads", function()
			local t = setup()
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			task.wait(utils.timings.grace)
			miumiu.step(t.world)
			expect(t.backend.calls.GetAsync).to.equal(nil)
			expect(link_state(t, "p1")).to.equal(nil)
		end)
	end)

	describe("regressions", function()
		it("warns when the final write after unlink fails and keeps retrying", function()
			local t = setup({ pull_interval = utils.timings.short, retry_attempts = 1 })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 4)
			local loaded = utils.session_of(t, "p1")
			t.backend:fail_next("UpdateAsync", "before", "down")
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(utils.wait_closed(loaded)).to.equal(true)
			expect(utils.warned(t.backend, "keeps retrying")).to.equal(true)
			expect(t.backend:dump("p1").data.money).to.equal(4)
		end)

		it("close before the first step touches nothing and stops later steps", function()
			local t = setup()
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			miumiu.close(t.world)
			miumiu.step(t.world)
			task.wait(utils.timings.grace)
			miumiu.step(t.world)
			expect(t.backend.calls.GetAsync).to.equal(nil)
			expect(t.world:has(player, t.loading)).to.equal(false)
		end)

		it("close keeps retrying a failed final write inside its budget", function()
			local t = setup({ pull_interval = never, retry_attempts = 1 })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 2)
			t.backend:fail_next("UpdateAsync", "before", "down")
			local before = #t.backend.warnings
			miumiu.close(t.world, utils.timings.budget)
			expect(t.backend:dump("p1").data.money).to.equal(2)
			for index = before + 1, #t.backend.warnings do
				expect((string.find(t.backend.warnings[index], "on close failed", 1, true))).to.equal(nil)
			end
		end)

		it("close unloads a session whose loaded event is still queued", function()
			local t = setup({ pull_interval = utils.timings.short })
			t.backend:delay_next("GetAsync", utils.timings.short, "before")
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			miumiu.step(t.world)
			expect(utils.wait_for_events(t, 1)).to.equal(true)
			miumiu.close(t.world)
			expect(#utils.events(t)).to.equal(0)
			local reads = t.backend.calls.GetAsync
			task.wait(utils.timings.grace)
			expect(t.backend.calls.GetAsync).to.equal(reads)
		end)

		it("close unloads a session orphaned by a failed unlink write", function()
			local t = setup({ pull_interval = never, retry_attempts = 1 })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 4)
			t.backend:fail_next("UpdateAsync", "before", "down")
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(utils.wait_until(function()
				return utils.orphans(t) > 0
			end)).to.equal(true)
			miumiu.close(t.world)
			expect(utils.orphans(t)).to.equal(0)
			expect(t.backend:dump("p1").data.money).to.equal(4)
		end)

		it("close makes one attempt per retry so the budget holds", function()
			local t = setup({ pull_interval = never, retry_attempts = 5, retry_base = 1 })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 4)
			t.backend:fail_next("UpdateAsync", "before", "down")
			local before = t.backend.calls.UpdateAsync or 0
			local started = os.time()
			miumiu.close(t.world, 0)
			expect(os.time() - started <= 1).to.equal(true)
			expect(t.backend.calls.UpdateAsync).to.equal(before + 1)
			expect((string.find(t.backend.warnings[#t.backend.warnings], "on close failed", 1, true))).to.be.ok()
		end)

		it("close waits for a final write an unlink already started", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 4)
			t.backend:delay_next("UpdateAsync", utils.timings.window, "before")
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(utils.orphans(t)).to.equal(1)
			miumiu.close(t.world)
			expect(t.backend:dump("p1").data.money).to.equal(4)
			expect(utils.orphans(t)).to.equal(0)
		end)

		it("close keeps going when a write lands but the session stays dirty", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local session = utils.session_of(t, "p1")
			t.world:set(player, t.money, 4)
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "after")
			local writes = t.backend.calls.UpdateAsync or 0
			local done = false
			task.spawn(function()
				miumiu.close(t.world)
				done = true
			end)
			expect(utils.wait_until(function()
				return t.backend.calls.UpdateAsync == writes + 1
			end)).to.equal(true)
			utils.journal(session, { utils.add("money", 1) })
			expect(utils.wait_until(function()
				return done
			end)).to.equal(true)
			expect(session:is_open()).to.equal(false)
			expect(t.backend:dump("p1").data.money).to.equal(5)
		end)

		it("close warns when a refused final write drops unwritten changes", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 4)
			t.backend:seed("p1", { data = { money = 1 }, migrations = 3 })
			miumiu.close(t.world, 0)
			expect(utils.warned(t.backend, "unwritten changes are lost")).to.equal(true)
			expect(t.backend:dump("p1").data.money).to.equal(1)
		end)

		it("close gives up on a final write that never returns", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local session = utils.session_of(t, "p1")
			local closed = false
			session:hook(miumiu.hooks.closed, function()
				closed = true
			end)
			t.world:set(player, t.money, 4)
			t.backend:delay_next("UpdateAsync", utils.timings.slow, "before")
			local started = os.time()
			miumiu.close(t.world, 0)
			expect(os.time() - started <= 1).to.equal(true)
			expect(utils.warned(t.backend, "did not return before the close budget")).to.equal(true)
			local status = session:get_status()
			assert(status.kind == "closed")
			expect(status.closure.kind).to.equal("abandoned")
			expect(closed).to.equal(true)
			expect(utils.wait_until(function()
				local record = t.backend:dump("p1")
				return record ~= nil and record.data.money == 4
			end)).to.equal(true)
		end)

		it("close finishes fifty dirty sessions in one write's time", function()
			local t = setup({ pull_interval = never })
			local players = {}
			for index = 1, 50 do
				local player = t.world:entity()
				t.world:set(player, t.link, `p{index}`)
				table.insert(players, player)
			end
			miumiu.step(t.world)
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				for _, player in players do
					if not t.world:has(player, t.loaded) then
						return false
					end
				end
				return true
			end)).to.equal(true)
			for index, player in players do
				t.world:set(player, t.money, index)
			end
			t.backend:delay_next("UpdateAsync", utils.timings.window, "before")
			local started = os.time()
			miumiu.close(t.world)
			expect(os.time() - started <= 1).to.equal(true)
			for index = 1, 50 do
				expect(t.backend:dump(`p{index}`).data.money).to.equal(index)
			end
		end)

		it("does not warn when an unlink waits behind a loop pull that closes the session", function()
			local t = setup({ pull_interval = utils.timings.short })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 4)
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			expect(utils.wait_until(function()
				return t.backend.calls.UpdateAsync == 1
			end)).to.equal(true)
			local session = utils.session_of(t, "p1")
			local warnings = #t.backend.warnings
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(utils.wait_closed(session)).to.equal(true)
			task.wait(utils.timings.grace)
			expect(#t.backend.warnings).to.equal(warnings)
			expect(t.backend:dump("p1").data.money).to.equal(4)
			local status = session:get_status()
			assert(status.kind == "closed")
			expect(status.closure.kind).to.equal("clean")
		end)

		it("leaves no entity state when a batch is refused after close", function()
			local t = setup({ pull_interval = never, retry_attempts = 1 })
			local a = utils.link_entity(t, "p1", { money = 10 })
			local b = utils.link_entity(t, "p2", { money = 1 })
			t.backend:delay_next("SetAsync", utils.timings.in_flight, "before")
			t.backend:fail_next("SetAsync", "before", "commit down")
			local batch = miumiu.batch(t.world, function()
				t.world:set(a, t.money, 6)
				t.world:set(b, t.money, 5)
			end)
			miumiu.close(t.world, utils.timings.budget)
			expect(utils.wait_settled(batch)).to.equal(true)
			expect(batch:get_outcome().kind).to.equal("refused")
			expect((next(state.get(t.world).entities))).to.equal(nil)
		end)

		it("close during a multi-key batch leaves records that converge", function()
			local t = setup({ pull_interval = never, retry_attempts = 1 })
			local a = utils.link_entity(t, "p1", { money = 10 })
			local b = utils.link_entity(t, "p2", { money = 0 })
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			local writes = t.backend.calls.UpdateAsync
			local batch = miumiu.batch(t.world, function()
				t.world:set(a, t.money, 7)
				t.world:set(b, t.money, 3)
			end)
			expect(utils.wait_until(function()
				return t.backend.calls.UpdateAsync > writes
			end)).to.equal(true)
			miumiu.close(t.world)
			expect(utils.wait_settled(batch)).to.equal(true)
			local reader = utils.other_server(t, "p1")
			local other = utils.other_server(t, "p2")
			local committed = reader:get_truth().money == 7
			expect(other:get_truth().money == 3).to.equal(committed)
			if not committed then
				expect(reader:get_truth().money).to.equal(10)
			end
		end)

		it("keeps the abandoned closure when the in-flight final write is refused later", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local session = utils.session_of(t, "p1")
			t.world:set(player, t.money, 4)
			t.backend:seed("p1", { data = { money = 1 }, migrations = 3 })
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			miumiu.close(t.world, 0)
			local status = session:get_status()
			assert(status.kind == "closed")
			expect(status.closure.kind).to.equal("abandoned")
			local closures = 0
			session:hook(miumiu.hooks.closed, function()
				closures += 1
			end)
			expect(utils.wait_until(function()
				return closures > 0
			end, utils.timings.grace)).to.equal(false)
			status = session:get_status()
			assert(status.kind == "closed")
			expect(status.closure.kind).to.equal("abandoned")
		end)

		it("closes a leave clean without a request when its lazy marks died with the entity", function()
			local t = setup({ pull_interval = never })
			local battery = utils.declare_saveable(t.world, "component", "battery", { t.player_data })
			t.world:add(battery, miumiu.lazy)
			local player = utils.link_entity(t, "p1")
			local session = utils.session_of(t, "p1")
			t.world:set(player, battery, 42)
			session:sync()
			t.world:set(player, battery, 43)
			local reads, writes = t.backend.calls.GetAsync, t.backend.calls.UpdateAsync
			local wrote = false
			session:hook(miumiu.hooks.writing, function()
				wrote = true
			end)
			t.world:delete(player)
			miumiu.step(t.world)
			expect(utils.wait_closed(session)).to.equal(true)
			expect(wrote).to.equal(false)
			expect(t.backend.calls.GetAsync).to.equal(reads)
			expect(t.backend.calls.UpdateAsync).to.equal(writes)
			local status = session:get_status()
			assert(status.kind == "closed")
			expect(status.closure.kind).to.equal("clean")
		end)

		it("close deletes the owned tree of every linked root", function()
			local t = setup({ pull_interval = never })
			local kinds = utils.declare_kinds(t.world, t.player_data)
			local player = utils.link_entity(t, "p1")
			local sword = t.world:entity()
			t.world:add(sword, kinds.item)
			t.world:add(sword, jecs.pair(kinds.owns, player))
			utils.session_of(t, "p1"):sync()
			miumiu.close(t.world)
			expect(t.world:contains(sword)).to.equal(false)
			expect(t.world:contains(player)).to.equal(true)
		end)

		it("a throwing listener on a snapshot component does not lose the pending lazy value at unlink", function()
			local t = setup({ pull_interval = never })
			local battery = utils.declare_saveable(t.world, "component", "battery", { t.player_data })
			t.world:add(battery, miumiu.lazy)
			local last_seen = utils.declare_saveable(t.world, "component", "last_seen", { t.player_data })
			local ticks = 0
			t.world:set(last_seen, miumiu.snapshot, function()
				ticks += 1
				return ticks
			end)
			local player = utils.link_entity(t, "p1")
			local session = utils.session_of(t, "p1")
			t.world:added(last_seen, function()
				error("boom")
			end)
			t.world:set(player, battery, 7)
			t.world:remove(player, t.link)
			expect(function()
				miumiu.step(t.world)
			end).to.throw("boom")
			expect(utils.wait_closed(session)).to.equal(true)
			expect(t.backend:dump("p1").data.battery).to.equal(7)
		end)
	end)
end
