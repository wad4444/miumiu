return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local handle = require(ReplicatedStorage.Packages.miumiu.handle)
	local hooks = require(ReplicatedStorage.Packages.miumiu.hooks)
	local utils = require(ReplicatedStorage.Tests.utils)

	afterEach(utils.cleanup)

	describe("handle.create_batch", function()
		it("starts pending and names itself by its outcome", function()
			local batch = handle.create_batch()
			expect(handle.is_batch(batch)).to.equal(true)
			expect(handle.is_batch({})).to.equal(false)
			expect(batch:get_outcome().kind).to.equal("pending")
			expect(batch:get_result()).to.equal(nil)
			batch:hold(7, { "k" })
			expect(batch:get_keys()[1]).to.equal("k")
			expect(#batch:get_keys()).to.equal(1)
			expect(batch:get_result()).to.equal(7)
			expect(batch:is_settled()).to.equal(false)
			expect(tostring(batch)).to.equal("Batch(pending)")
			batch:land()
			expect(tostring(batch)).to.equal("Batch(landed)")
			local refused = handle.create_batch()
			refused:hook(hooks.refused, function() end)
			refused:hold(nil, { "k" })
			refused:refuse("id", "no", false)
			expect(tostring(refused)).to.equal("Batch(refused)")
			local outcome = refused:get_outcome()
			assert(outcome.kind == "refused")
			expect(outcome.message).to.equal("no")
		end)

		it("fires hooks connected before and after settling, once each", function()
			local batch = handle.create_batch()
			local landed = 0
			local disconnect = batch:hook(hooks.landed, function()
				landed += 1
			end)
			batch:hook(hooks.refused, function()
				landed -= 100
			end)
			batch:land()
			expect(landed).to.equal(1)
			batch:hook(hooks.landed, function()
				landed += 10
			end)
			expect(landed).to.equal(11)
			disconnect()
			batch:land()
			expect(landed).to.equal(11)
		end)

		it("wakes every waiter, skips a dead one, and returns the refusal from await", function()
			local batch = handle.create_batch()
			local woke = 0
			for _ = 1, 2 do
				task.spawn(function()
					batch:await()
					woke += 1
				end)
			end
			local dead = task.spawn(function()
				batch:await()
			end)
			task.cancel(dead)
			batch:land()
			expect(woke).to.equal(2)
			batch:await()
			local refused = handle.create_batch()
			local caught = nil
			task.spawn(function()
				local outcome = refused:await()
				caught = if outcome.kind == "refused" then outcome.message else outcome.kind
			end)
			refused:hook(hooks.refused, function() end)
			refused:hold(nil, { "k" })
			refused:refuse("id", "store down", false)
			expect(caught).to.equal("store down")
			expect(refused:await().kind).to.equal("refused")
			expect(batch:await().kind).to.equal("landed")
		end)

		it("runs the flush on await while pending, then waits for the settle", function()
			local batch = handle.create_batch()
			local flushed = 0
			batch:flush_with(function()
				flushed += 1
				batch:land()
			end)
			expect(batch:await().kind).to.equal("landed")
			expect(flushed).to.equal(1)
			batch:await()
			expect(flushed).to.equal(1)
			local waiting = handle.create_batch()
			waiting:flush_with(function()
				flushed += 1
			end)
			local outcome = nil
			task.spawn(function()
				outcome = waiting:await().kind
			end)
			expect(flushed).to.equal(2)
			expect(outcome).to.equal(nil)
			task.spawn(function()
				waiting:await()
			end)
			expect(flushed).to.equal(2)
			waiting:land()
			expect(outcome).to.equal("landed")
		end)

		it("drops the flush once settled and refuses an await while the function runs", function()
			local batch = handle.create_batch()
			local flushed = 0
			batch:flush_with(function()
				flushed += 1
			end)
			batch:land()
			expect(batch:await().kind).to.equal("landed")
			expect(flushed).to.equal(0)
			local running = handle.create_batch()
			running:enter()
			expect(function()
				running:await()
			end).to.throw("inside its own function")
			running:hold(nil, {})
			running:land()
			expect(running:await().kind).to.equal("landed")
		end)

		it("warns a frame later when nobody hooked the refusal", function()
			local backend = utils.create_backend()
			local hooked = handle.create_batch()
			hooked:hold(nil, { "k1", "k2" })
			hooked:refuse("a", "no", false)
			hooked:hook(hooks.refused, function() end)
			local awaited = handle.create_batch()
			task.spawn(function()
				awaited:await()
			end)
			awaited:hold(nil, { "k1" })
			awaited:refuse("c", "no", false)
			local heard = handle.create_batch()
			heard:hold(nil, { "k1" })
			heard:refuse("d", "no", true)
			local silent = handle.create_batch()
			silent:hold(nil, { "k1", "k2" })
			silent:refuse("b", "no", false)
			expect(#backend.warnings).to.equal(0)
			task.wait()
			expect(#backend.warnings).to.equal(1)
			expect(utils.warned(backend, 'batch b on "k1", "k2" refused')).to.equal(true)
		end)
	end)
end
