return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local jecs = require(ReplicatedStorage.Packages.jecs)
	local miumiu = require(ReplicatedStorage.Packages.miumiu)
	local utils = require(ReplicatedStorage.Tests.utils)

	afterEach(utils.cleanup)

	local never = utils.timings.never

	local setup = utils.create_fixture
	local settle = utils.settle

	local link_state = utils.link_state

	describe("link", function()
		it("marks loading, then loaded", function()
			local t = setup()
			t.backend:delay_next("GetAsync", utils.timings.short, "before")
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			miumiu.step(t.world)
			expect(t.world:has(player, t.loading)).to.equal(true)
			expect(settle(t, player)).to.equal(true)
			expect(t.world:has(player, t.loaded)).to.equal(true)
			expect(t.world:has(player, t.loading)).to.equal(false)
		end)

		it("supplies stored data and leaves missing keys alone", function()
			local t = setup()
			t.backend:seed("p1", { data = { money = 5, tutorial = true } })
			local player = t.world:entity()
			t.world:set(player, t.money, 1)
			t.world:set(player, t.items, { "default" })
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect(t.world:get(player, t.money)).to.equal(5)
			expect(t.world:has(player, t.tutorial)).to.equal(true)
			expect(t.world:get(player, t.items)[1]).to.equal("default")
		end)

		it("fills initial values from the component on itself", function()
			local t = setup({ pull_interval = never })
			t.world:set(t.money, t.money, 100)
			t.world:set(t.items, t.items, { "starter" })
			t.world:add(t.tutorial, t.tutorial)
			t.backend:seed("p2", { data = { money = 5 } })

			local fresh = t.world:entity()
			t.world:set(fresh, t.link, "p1")
			local stored = t.world:entity()
			t.world:set(stored, t.link, "p2")
			local kept = t.world:entity()
			t.world:set(kept, t.money, 7)
			t.world:set(kept, t.link, "p3")
			miumiu.step(t.world)
			expect(t.world:get(fresh, t.money)).to.equal(100)
			expect(t.world:has(fresh, t.tutorial)).to.equal(true)
			settle(t, fresh)
			settle(t, stored)
			settle(t, kept)

			expect(t.world:get(fresh, t.money)).to.equal(100)
			expect(t.world:get(fresh, t.items)[1]).to.equal("starter")
			expect(t.world:get(fresh, t.items)).never.to.equal(t.world:get(t.items, t.items))
			expect(t.world:get(fresh, t.items)).never.to.equal(t.world:get(stored, t.items))
			expect(t.world:get(stored, t.money)).to.equal(5)
			expect(t.world:get(kept, t.money)).to.equal(7)

			utils.session_of(t, "p1"):sync()
			expect(t.backend:dump("p1")).to.equal(nil)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
		end)

		it("guards writes and stored values", function()
			local t = setup({ pull_interval = never })
			t.world:set(t.money, miumiu.guard, function(value)
				return type(value) == "number", "money must be a number"
			end)
			t.backend:seed("p2", { data = { money = "lots" } })

			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect(function()
				t.world:set(player, t.money, "many")
			end).to.throw("money must be a number")
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(false)
			t.world:set(player, t.money, 3)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(true)

			expect(function()
				miumiu.batch(t.world, function()
					t.world:set(player, t.money, 4)
					t.world:set(player, t.money, "oops")
				end)
			end).to.throw("money must be a number")
			expect(t.world:get(player, t.money)).to.equal(3)

			local other = t.world:entity()
			t.world:set(other, t.money, 1)
			t.world:set(other, t.link, "p2")
			settle(t, other)
			expect(t.world:get(other, t.money)).to.equal(1)
			expect((string.find(t.backend.warnings[#t.backend.warnings], "money must be a number", 1, true))).to.be.ok()
		end)

		it("serializes on write and deserializes on load", function()
			local t = setup({ pull_interval = never })
			local codes = t.world:component()
			t.world:set(codes, jecs.Name, "codes")
			t.world:set(codes, miumiu.saveable, "codes")
			t.world:set(codes, miumiu.guard, function(value)
				return type(value) == "table" and getmetatable(value) == nil, "codes must be a set"
			end)
			t.world:set(codes, miumiu.serdes, utils.create_set_serdes())
			t.backend:seed("p2", { data = { codes = { "b", "a" } } })
			t.backend:seed("p3", { data = { codes = "garbage" } })

			local writer = t.world:entity()
			t.world:set(writer, t.link, "p1")
			settle(t, writer)
			t.world:set(writer, codes, { x = true, y = true })
			utils.session_of(t, "p1"):sync()
			expect(table.concat(t.backend:dump("p1").data.codes, ",")).to.equal("x,y")

			local reader = t.world:entity()
			t.world:set(reader, t.link, "p2")
			settle(t, reader)
			local set = t.world:get(reader, codes)
			expect(set.a).to.equal(true)
			expect(set.b).to.equal(true)
			utils.session_of(t, "p2"):sync()
			miumiu.step(t.world)
			expect(t.world:get(reader, codes)).to.equal(set)

			miumiu
				.delta(t.world, function()
					local next_set = table.clone(t.world:get(reader, codes))
					next_set.c = true
					t.world:set(reader, codes, next_set)
				end)
				:await()
			expect(table.concat(t.backend:dump("p2").data.codes, ",")).to.equal("b,a,c")

			local broken = t.world:entity()
			t.world:set(broken, codes, { keep = true })
			t.world:set(broken, t.link, "p3")
			settle(t, broken)
			expect(t.world:get(broken, codes).keep).to.equal(true)
			expect((string.find(t.backend.warnings[#t.backend.warnings], "not a list", 1, true))).to.be.ok()
		end)

		it("picks up links made before the first step", function()
			local t = setup()
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			local other = t.world:entity()
			t.world:set(other, t.link, "p2")
			expect(settle(t, player)).to.equal(true)
			expect(settle(t, other)).to.equal(true)
		end)

		it("sets data_error when the load fails", function()
			local t = setup({ retry_attempts = 1 })
			t.backend:fail_next("GetAsync", "before", "boom")
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect((string.find(t.world:get(player, t.data_error), "boom"))).to.be.ok()
			expect(t.world:has(player, t.loaded)).to.equal(false)
			expect(link_state(t, "p1")).to.equal(nil)
		end)
	end)

	describe("regressions", function()
		it("relinking during a pending load keeps one session", function()
			local t = setup({ pull_interval = never })
			t.backend:delay_next("GetAsync", utils.timings.short, "before")
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			miumiu.step(t.world)
			t.world:remove(player, t.link)
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local loaded = utils.session_of(t, "p1")
			expect(miumiu.get_session(t.world, t.player_data, "p1")).to.equal(loaded)
			task.wait(utils.timings.grace)
			miumiu.step(t.world)
			expect(utils.session_of(t, "p1")).to.equal(loaded)
			expect(loaded:is_open()).to.equal(true)
		end)

		it("changing the key relinks", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local first = utils.session_of(t, "p1")
			t.world:set(player, t.link, "p2")
			settle(t, player)
			expect(utils.wait_until(function()
				return not first:is_open()
			end)).to.equal(true)
			expect(link_state(t, "p1")).to.equal(nil)
			t.world:set(player, t.money, 6)
			utils.session_of(t, "p2"):sync()
			expect(t.backend:dump("p2").data.money).to.equal(6)
			expect(t.backend:dump("p1")).to.equal(nil)
		end)

		it("ignores a link on an entity deleted before the step", function()
			local t = setup({ pull_interval = never })
			miumiu.step(t.world)
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			t.world:delete(player)
			miumiu.step(t.world)
			task.wait(utils.timings.grace)
			miumiu.step(t.world)
			expect(link_state(t, "p1")).to.equal(nil)
			expect(t.backend.calls.GetAsync).to.equal(nil)
		end)

		it("supplies a late entity from the loaded session at once", function()
			local t = setup({ pull_interval = never })
			local first = t.world:entity()
			t.world:set(first, t.link, "p1")
			settle(t, first)
			t.world:set(first, t.money, 3)
			local second = t.world:entity()
			t.world:set(second, t.link, "p1")
			miumiu.step(t.world)
			expect(t.world:has(second, t.loaded)).to.equal(true)
			expect(t.world:get(second, t.money)).to.equal(3)
		end)

		it("unloads a load result that arrives for a replaced link", function()
			local t = setup({ pull_interval = never })
			t.backend:delay_next("GetAsync", utils.timings.short, "before")
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			miumiu.step(t.world)
			t.world:remove(player, t.link)
			t.world:set(player, t.link, "p1")
			expect(utils.wait_for_events(t, 3)).to.equal(true)
			settle(t, player)
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				return utils.orphans(t) == 0
			end)).to.equal(true)
			expect(utils.session_of(t, "p1"):is_open()).to.equal(true)
			expect(t.world:has(player, t.loaded)).to.equal(true)
			expect(t.backend.calls.GetAsync).to.equal(2)
		end)

		it("ignores a load failure for a link that was replaced meanwhile", function()
			local t = setup({ pull_interval = never, retry_attempts = 1 })
			t.backend:delay_next("GetAsync", utils.timings.short, "before")
			t.backend:fail_next("GetAsync", "before", "boom")
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			miumiu.step(t.world)
			t.world:remove(player, t.link)
			local other = t.world:entity()
			t.world:set(other, t.link, "p1")
			expect(utils.wait_until(function()
				return #utils.events(t) == 3
			end)).to.equal(true)
			miumiu.step(t.world)
			expect(t.world:has(player, t.data_error)).to.equal(false)
			expect(t.world:has(other, t.data_error)).to.equal(false)
			expect(t.world:has(other, t.loading)).to.equal(true)
			expect(link_state(t, "p1")).to.be.ok()
			settle(t, other)
			expect(t.world:has(other, t.loaded)).to.equal(true)
		end)

		it("a bad collection config lands in data_error", function()
			local t = setup({ pull_interval = never })
			local broken = t.world:entity()
			t.world:set(broken, miumiu.collection, "")
			utils.scope(t.world, { t.money, t.items, t.tutorial }, { t.player_data, broken })
			local player = t.world:entity()
			t.world:set(player, jecs.pair(miumiu.data_link, broken), "p1")
			miumiu.step(t.world)
			local err = t.world:get(player, jecs.pair(miumiu.data_error, broken))
			expect((string.find(err, "has no name", 1, true))).to.be.ok()
			expect(t.world:has(player, jecs.pair(miumiu.data_loading, broken))).to.equal(false)
		end)

		it("marks every entity of a key loaded when an added data_loaded listener throws", function()
			local t = setup({ pull_interval = never })
			local a = t.world:entity()
			local b = t.world:entity()
			t.world:set(a, t.link, "p1")
			t.world:set(b, t.link, "p1")
			local disconnect = t.world:added(miumiu.data_loaded, function()
				error("added boom")
			end)
			miumiu.step(t.world)
			expect(utils.wait_for_events(t, 1)).to.equal(true)
			expect(function()
				miumiu.step(t.world)
			end).to.throw("added boom")
			disconnect()
			expect(t.world:has(a, t.loaded)).to.equal(true)
			expect(t.world:has(b, t.loaded)).to.equal(true)
			expect(t.world:has(a, t.loading)).to.equal(false)
			expect(t.world:has(b, t.loading)).to.equal(false)
		end)

		it("a second link to an entity that is no collection lands in data_error", function()
			local t = setup({ pull_interval = never })
			local bogus = t.world:entity()
			local player = utils.link_entity(t, "p1")
			t.world:set(player, jecs.pair(miumiu.data_link, bogus), "p1")
			miumiu.step(t.world)
			local err = t.world:get(player, jecs.pair(miumiu.data_error, bogus))
			expect((string.find(err, "is not a collection", 1, true))).to.be.ok()
		end)

		it("get_session hands out the open session and nothing otherwise", function()
			local t = setup({ pull_interval = never })
			expect(miumiu.get_session(t.world, t.player_data, "p1")).to.equal(nil)
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			miumiu.step(t.world)
			expect(miumiu.get_session(t.world, t.player_data, "p1")).to.equal(nil)
			settle(t, player)
			local session = miumiu.get_session(t.world, t.player_data, "p1")
			expect(session).to.equal(utils.session_of(t, "p1"))
			expect(miumiu.is_session(session)).to.equal(true)
			t.world:set(player, t.money, 3)
			expect(session:is_dirty()).to.equal(true)
			session:sync()
			expect(t.backend:dump("p1").data.money).to.equal(3)
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(miumiu.get_session(t.world, t.player_data, "p1")).to.equal(nil)
		end)

		it("marks entities loaded and rethrows when a listener throws during the first supply", function()
			local t = setup({ pull_interval = never })
			t.backend:seed("p1", { data = { money = 5, tutorial = true } })
			t.world:added(t.money, function()
				error("supply boom")
			end)
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			miumiu.step(t.world)
			expect(utils.wait_until(function()
				return #utils.events(t) > 0
			end)).to.equal(true)
			expect(function()
				miumiu.step(t.world)
			end).to.throw("supply boom")
			expect(t.world:has(player, t.loaded)).to.equal(true)
			expect(t.world:has(player, t.loading)).to.equal(false)
			expect(t.world:get(player, t.money)).to.equal(5)
			expect(t.world:has(player, t.tutorial)).to.equal(true)
			miumiu.step(t.world)
			t.world:set(player, t.money, 6)
			expect(utils.session_of(t, "p1"):is_dirty()).to.equal(true)
		end)

		it("marks a late entity loaded and rethrows when a listener throws", function()
			local t = setup({ pull_interval = never })
			t.backend:seed("p1", { data = { money = 5 } })
			local first = t.world:entity()
			t.world:set(first, t.link, "p1")
			settle(t, first)
			t.world:added(t.money, function()
				error("late boom")
			end)
			local late = t.world:entity()
			t.world:set(late, t.link, "p1")
			expect(function()
				miumiu.step(t.world)
			end).to.throw("late boom")
			expect(t.world:has(late, t.loaded)).to.equal(true)
			expect(t.world:get(late, t.money)).to.equal(5)
		end)

		it("drops the link with data_error when the session closes on a newer record", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local session = utils.session_of(t, "p1")
			t.backend:seed("p1", { data = { money = 1 }, migrations = 3 })
			expect(function()
				session:sync()
			end).to.throw("newer server")
			miumiu.step(t.world)
			expect(t.world:has(player, t.loaded)).to.equal(false)
			expect((string.find(t.world:get(player, t.data_error), "newer server"))).to.be.ok()
			expect(link_state(t, "p1")).to.equal(nil)
			expect(miumiu.get_session(t.world, t.player_data, "p1")).to.equal(nil)
			expect(function()
				miumiu.batch(t.world, function()
					t.world:set(player, t.money, 2)
				end)
			end).to.throw("not loaded")
		end)

		it("ignores a closed event for a link that moved on", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local session = utils.session_of(t, "p1")
			t.backend:seed("p1", { data = { money = 1 }, migrations = 3 })
			local warnings = #t.backend.warnings
			t.world:remove(player, t.link)
			pcall(session.sync, session)
			miumiu.step(t.world)
			expect(#t.backend.warnings).to.equal(warnings)
			expect(t.world:has(player, t.loaded)).to.equal(false)
			expect(t.world:has(player, t.data_error)).to.equal(false)
			expect(link_state(t, "p1")).to.equal(nil)
			local other = t.world:entity()
			t.world:set(other, t.link, "p1")
			settle(t, other)
			expect((string.find(t.world:get(other, t.data_error), "newer server"))).to.be.ok()
		end)

		it("does not keep a session that closed during its final write", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 4)
			t.backend:seed("p1", { data = { money = 1 }, migrations = 3 })
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(utils.wait_until(function()
				return #t.backend.warnings > 0
					and string.find(t.backend.warnings[#t.backend.warnings], "newer server", 1, true) ~= nil
			end)).to.equal(true)
			expect(utils.orphans(t)).to.equal(0)
		end)

		it("rejects a link without a key", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:add(player, t.link)
			miumiu.step(t.world)
			expect((string.find(t.world:get(player, t.data_error), "without a key"))).to.be.ok()
			expect(t.world:has(player, t.loading)).to.equal(false)
			expect(link_state(t, "")).to.equal(nil)
		end)

		it("re-setting the same key keeps the session", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local session = utils.session_of(t, "p1")
			t.world:set(player, t.link, "p1")
			expect(#utils.events(t)).to.equal(0)
			miumiu.step(t.world)
			expect(utils.session_of(t, "p1")).to.equal(session)
			expect(session:is_open()).to.equal(true)
			expect(t.world:has(player, t.loaded)).to.equal(true)
		end)

		it("get_session before the first step leaves the schema open", function()
			local t = setup({ pull_interval = never })
			expect(miumiu.get_session(t.world, t.player_data, "p1")).to.equal(nil)
			expect(function()
				utils.declare_saveable(t.world, "component", "late")
			end).never.to.throw()
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect(t.world:has(player, t.loaded)).to.equal(true)
		end)

		it("loads a key again once a failed link is removed and set back", function()
			local t = setup({ pull_interval = never, retry_attempts = 1 })
			t.backend:fail_next("GetAsync", "before", "outage")
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect((string.find(t.world:get(player, t.data_error), "outage"))).to.be.ok()
			t.world:remove(player, t.link)
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect(t.world:has(player, t.loaded)).to.equal(true)
			expect(t.world:has(player, t.data_error)).to.equal(false)
		end)

		it("loads twenty keys linked in one frame", function()
			local t = setup({ pull_interval = never })
			local players = {}
			for index = 1, 20 do
				local player = t.world:entity()
				t.world:set(player, t.link, `p{index}`)
				t.backend:seed(`p{index}`, { data = { money = index } })
				table.insert(players, player)
			end
			miumiu.step(t.world)
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				for _, player in players do
					if not t.world:has(player, t.loaded) then
						return false
					end
				end
				return true
			end)).to.equal(true)
			for index, player in players do
				expect(t.world:get(player, t.money)).to.equal(index)
			end
		end)

		it("relinking a key whose final write is in flight takes the session back", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local session = utils.session_of(t, "p1")
			t.world:set(player, t.money, 4)
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			local unloading = link_state(t, "p1")
			assert(unloading)
			expect(unloading.phase.kind).to.equal("unloading")
			expect(utils.orphans(t)).to.equal(1)
			local other = t.world:entity()
			t.world:set(other, t.link, "p1")
			miumiu.step(t.world)
			expect(t.world:has(other, t.loaded)).to.equal(true)
			expect(t.world:get(other, t.money)).to.equal(4)
			expect(utils.session_of(t, "p1")).to.equal(session)
			expect(utils.orphans(t)).to.equal(0)
			expect(t.backend.calls.GetAsync).to.equal(1)
			t.world:set(other, t.money, 5)
			expect(utils.wait_until(function()
				return t.backend:dump("p1") ~= nil and t.backend:dump("p1").data.money == 5
			end)).to.equal(true)
			expect(session:is_open()).to.equal(true)
			expect(session:is_dirty()).to.equal(false)
			t.world:remove(other, t.link)
			miumiu.step(t.world)
			expect(session:is_open()).to.equal(false)
			expect(link_state(t, "p1")).to.equal(nil)
		end)

		it("relinking after the final write already refused the session loads fresh", function()
			local t = setup({ pull_interval = never })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 4)
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			t.backend:seed("p1", { data = { money = 1 }, migrations = 3 })
			local other = t.world:entity()
			t.world:set(other, t.link, "p1")
			expect(utils.wait_until(function()
				return utils.warned(t.backend, "after unlink was refused")
			end)).to.equal(true)
			expect(#utils.events(t)).to.equal(2)
			settle(t, other)
			expect((string.find(t.world:get(other, t.data_error), "newer server"))).to.be.ok()
			expect(utils.orphans(t)).to.equal(0)
		end)

		it("relinking after an unlink whose final write failed takes the session back at once", function()
			local t =
				setup({ pull_interval = utils.timings.short, idle_interval = utils.timings.never, retry_attempts = 1 })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 4)
			t.backend:fail_next("UpdateAsync", "before", "outage")
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			expect(utils.wait_until(function()
				return utils.warned(t.backend, "keeps retrying")
			end)).to.equal(true)
			local other = t.world:entity()
			t.world:set(other, t.link, "p1")
			miumiu.step(t.world)
			expect(t.world:has(other, t.loaded)).to.equal(true)
			expect(t.world:get(other, t.money)).to.equal(4)
			expect(utils.wait_until(function()
				return t.backend:dump("p1") ~= nil and t.backend:dump("p1").data.money == 4
			end)).to.equal(true)
		end)

		it("flipping the key and back within one frame keeps the first key", function()
			local t = setup({ pull_interval = never })
			t.backend:seed("p2", { data = { money = 2 } })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			local session = utils.session_of(t, "p1")
			t.world:set(player, t.money, 4)
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			t.world:set(player, t.link, "p2")
			t.world:set(player, t.link, "p2")
			t.world:set(player, t.link, "p1")
			expect(#utils.events(t)).to.equal(4)
			settle(t, player)
			expect(utils.session_of(t, "p1")).to.equal(session)
			expect(t.world:has(player, t.loaded)).to.equal(true)
			expect(utils.wait_until(function()
				miumiu.step(t.world)
				return link_state(t, "p2") == nil
			end)).to.equal(true)
			t.world:set(player, t.money, 5)
			expect(session:is_dirty()).to.equal(true)
		end)

		it("marks an entity whose initial supply throws and rethrows", function()
			local t = setup({ pull_interval = never })
			t.world:set(t.money, t.money, 100)
			t.world:added(t.money, function()
				error("initial boom")
			end)
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			expect(function()
				miumiu.step(t.world)
			end).to.throw("initial boom")
			expect(t.world:has(player, t.loading)).to.equal(true)
			settle(t, player)
			expect(t.world:has(player, t.loaded)).to.equal(true)
		end)

		it("does not warn when a relink takes over an unload whose write then fails", function()
			local t = setup({ pull_interval = never, retry_attempts = 1 })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			t.world:set(player, t.money, 4)
			t.backend:delay_next("UpdateAsync", utils.timings.in_flight, "before")
			t.backend:fail_next("UpdateAsync", "after", "late")
			t.world:remove(player, t.link)
			miumiu.step(t.world)
			local other = t.world:entity()
			t.world:set(other, t.link, "p1")
			miumiu.step(t.world)
			expect(t.world:has(other, t.loaded)).to.equal(true)
			expect(utils.wait_until(function()
				return t.backend:dump("p1") ~= nil and t.backend:dump("p1").data.money == 4
			end)).to.equal(true)
			task.wait(utils.timings.grace)
			expect(utils.warned(t.backend, "keeps retrying")).to.equal(false)
			expect(utils.session_of(t, "p1"):is_open()).to.equal(true)
		end)

		it("drops every entity of a link even when a data_error listener throws", function()
			local t = setup({ pull_interval = never })
			local a = t.world:entity()
			local b = t.world:entity()
			t.world:set(a, t.link, "p1")
			t.world:set(b, t.link, "p1")
			settle(t, a)
			settle(t, b)
			t.world:added(miumiu.data_error, function()
				error("error boom")
			end)
			t.backend:seed("p1", { data = { money = 1 }, migrations = 3 })
			pcall(utils.session_of(t, "p1").sync, utils.session_of(t, "p1"))
			expect(function()
				miumiu.step(t.world)
			end).to.throw("error boom")
			expect(link_state(t, "p1")).to.equal(nil)
			expect(t.world:has(a, t.data_error)).to.equal(true)
			expect(t.world:has(b, t.data_error)).to.equal(true)
			expect(miumiu.get_session(t.world, t.player_data, "p1")).to.equal(nil)
		end)

		it("skips a stored value whose guard throws", function()
			local t = setup({ pull_interval = never })
			t.world:set(t.money, miumiu.guard, function(value)
				if type(value) ~= "number" then
					error("guard boom")
				end
				return true
			end)
			t.backend:seed("p1", { data = { money = "x" } })
			local player = t.world:entity()
			t.world:set(player, t.link, "p1")
			settle(t, player)
			expect(t.world:has(player, t.money)).to.equal(false)
			expect(utils.warned(t.backend, "guard boom")).to.equal(true)
		end)
	end)
end
